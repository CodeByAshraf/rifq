# Values embedded in the app at build time (npm run build). All of them are PUBLIC:
# anyone can read them from the installed app. Access to data is enforced by Supabase RLS.
# NEVER put the Supabase service-role / secret key here: the build refuses it.

# Optional: accounts and sync (Supabase project → Settings → API)
RIFQ_SUPABASE_URL=
RIFQ_SUPABASE_ANON_KEY=

# Optional: Cloudflare Turnstile CAPTCHA site key (its secret key goes in the Supabase dashboard)
RIFQ_TURNSTILE_SITE_KEY=

# Contact email shown in the app and on the store pages (privacy, account deletion).
# Required by Google Play and the App Store.
RIFQ_CONTACT_EMAIL=

# Optional: link shared by «شارك التطبيق» (e.g. the Google Play / App Store page, once published)
RIFQ_SHARE_URL=
