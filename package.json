{
  "name": "rifq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-app.mjs --dev",
    "build": "npm run verify:content && node scripts/build-app.mjs",
    "import:quran": "node scripts/import-quran.mjs",
    "verify:quran": "node scripts/verify-quran.mjs",
    "typecheck": "tsc --noEmit",
    "import:tafsir": "node scripts/import-tafsir.mjs",
    "test:validation": "node scripts/test-validation.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test:security": "node scripts/test-validation.mjs && node scripts/test-db.mjs",
    "audit": "npm audit --omit=dev",
    "test:rls": "node scripts/test-rls.mjs",
    "build:adhkar": "node scripts/build-adhkar.mjs",
    "verify:adhkar": "node scripts/verify-adhkar.mjs",
    "verify:content": "node scripts/verify-quran.mjs && node scripts/verify-adhkar.mjs && node scripts/build-mushaf.mjs --verify",
    "app:sync": "npm run build && npx cap sync && node scripts/native-config.mjs",
    "app:icons": "node scripts/app-icons.mjs && npx capacitor-assets generate --assetPath mobile/assets --android --ios --iosProject mobile/ios/App --androidProject mobile/android",
    "app:configure": "node scripts/native-config.mjs",
    "app:android": "npx cap open android",
    "app:ios": "npx cap open ios",
    "test:fajr": "node scripts/test-fajr.mjs",
    "app:sound": "node --no-warnings scripts/fajr-sound.mjs",
    "build:legal": "node scripts/build-legal.mjs",
    "build:mushaf": "node scripts/build-mushaf.mjs",
    "verify:mushaf": "node scripts/build-mushaf.mjs --verify"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/baloo-bhaijaan-2": "^5.3.0",
    "@fontsource/readex-pro": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "adhan": "4.4.6",
    "framer-motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@electric-sql/pglite": "^0.5.17",
    "@quran.ws/text": "^0.1.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "quran-json": "^3.1.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5"
  }
}
