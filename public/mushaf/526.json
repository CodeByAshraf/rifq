{"p":526,"j":27,"rows":[{"h":53},{"b":1},{"l":[[53,1,"وَٱلنَّجۡمِ إِذَا هَوَىٰ",true],[53,2,"مَا ضَلَّ صَاحِبُكُمۡ وَمَا غَوَىٰ",true],[53,3,"وَمَا يَنطِقُ عَنِ",false]]},{"l":[[53,3,"ٱلۡهَوَىٰٓ",true],[53,4,"إِنۡ هُوَ إِلَّا وَحۡيࣱ يُوحَىٰ",true],[53,5,"عَلَّمَهُۥ شَدِيدُ ٱلۡقُوَىٰ",true],[53,6,"ذُو مِرَّةࣲ",false]]},{"l":[[53,6,"فَٱسۡتَوَىٰ",true],[53,7,"وَهُوَ بِٱلۡأُفُقِ ٱلۡأَعۡلَىٰ",true],[53,8,"ثُمَّ دَنَا فَتَدَلَّىٰ",true],[53,9,"فَكَانَ قَابَ",false]]},{"l":[[53,9,"قَوۡسَيۡنِ أَوۡ أَدۡنَىٰ",true],[53,10,"فَأَوۡحَىٰٓ إِلَىٰ عَبۡدِهِۦ مَآ أَوۡحَىٰ",true],[53,11,"مَا كَذَبَ ٱلۡفُؤَادُ",false]]},{"l":[[53,11,"مَا رَأَىٰٓ",true],[53,12,"أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ",true],[53,13,"وَلَقَدۡ رَءَاهُ نَزۡلَةً أُخۡرَىٰ",true]]},{"l":[[53,14,"عِندَ سِدۡرَةِ ٱلۡمُنتَهَىٰ",true],[53,15,"عِندَهَا جَنَّةُ ٱلۡمَأۡوَىٰٓ",true],[53,16,"إِذۡ يَغۡشَى ٱلسِّدۡرَةَ",false]]},{"l":[[53,16,"مَا يَغۡشَىٰ",true],[53,17,"مَا زَاغَ ٱلۡبَصَرُ وَمَا طَغَىٰ",true],[53,18,"لَقَدۡ رَأَىٰ مِنۡ ءَايَٰتِ رَبِّهِ",false]]},{"l":[[53,18,"ٱلۡكُبۡرَىٰٓ",true],[53,19,"أَفَرَءَيۡتُمُ ٱللَّٰتَ وَٱلۡعُزَّىٰ",true],[53,20,"وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلۡأُخۡرَىٰٓ",true]]},{"l":[[53,21,"أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلۡأُنثَىٰ",true],[53,22,"تِلۡكَ إِذࣰا قِسۡمَةࣱ ضِيزَىٰٓ",true],[53,23,"إِنۡ هِيَ إِلَّآ أَسۡمَآءࣱ",false]]},{"l":[[53,23,"سَمَّيۡتُمُوهَآ أَنتُمۡ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلۡطَٰنٍۚ إِن يَتَّبِعُونَ إِلَّا",false]]},{"l":[[53,23,"ٱلظَّنَّ وَمَا تَهۡوَى ٱلۡأَنفُسُۖ وَلَقَدۡ جَآءَهُم مِّن رَّبِّهِمُ ٱلۡهُدَىٰٓ",true],[53,24,"أَمۡ لِلۡإِنسَٰنِ",false]]},{"l":[[53,24,"مَا تَمَنَّىٰ",true],[53,25,"فَلِلَّهِ ٱلۡأٓخِرَةُ وَٱلۡأُولَىٰ",true],[53,26,"۞ وَكَم مِّن مَّلَكࣲ فِي ٱلسَّمَٰوَٰتِ",false]]},{"l":[[53,26,"لَا تُغۡنِي شَفَٰعَتُهُمۡ شَيۡـًٔا إِلَّا مِنۢ بَعۡدِ أَن يَأۡذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرۡضَىٰٓ",true]]}]}