{"p":451,"j":23,"rows":[{"l":[[37,127,"فَكَذَّبُوهُ فَإِنَّهُمۡ لَمُحۡضَرُونَ",true],[37,128,"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ",true]]},{"l":[[37,129,"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ",true],[37,130,"سَلَٰمٌ عَلَىٰٓ إِلۡ يَاسِينَ",true],[37,131,"إِنَّا",false]]},{"l":[[37,131,"كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",true],[37,132,"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ",true]]},{"l":[[37,133,"وَإِنَّ لُوطࣰا لَّمِنَ ٱلۡمُرۡسَلِينَ",true],[37,134,"إِذۡ نَجَّيۡنَٰهُ وَأَهۡلَهُۥٓ أَجۡمَعِينَ",true]]},{"l":[[37,135,"إِلَّا عَجُوزࣰا فِي ٱلۡغَٰبِرِينَ",true],[37,136,"ثُمَّ دَمَّرۡنَا ٱلۡأٓخَرِينَ",true],[37,137,"وَإِنَّكُمۡ",false]]},{"l":[[37,137,"لَتَمُرُّونَ عَلَيۡهِم مُّصۡبِحِينَ",true],[37,138,"وَبِٱلَّيۡلِۚ أَفَلَا تَعۡقِلُونَ",true],[37,139,"وَإِنَّ",false]]},{"l":[[37,139,"يُونُسَ لَمِنَ ٱلۡمُرۡسَلِينَ",true],[37,140,"إِذۡ أَبَقَ إِلَى ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ",true]]},{"l":[[37,141,"فَسَاهَمَ فَكَانَ مِنَ ٱلۡمُدۡحَضِينَ",true],[37,142,"فَٱلۡتَقَمَهُ ٱلۡحُوتُ وَهُوَ مُلِيمࣱ",true]]},{"l":[[37,143,"فَلَوۡلَآ أَنَّهُۥ كَانَ مِنَ ٱلۡمُسَبِّحِينَ",true],[37,144,"لَلَبِثَ فِي بَطۡنِهِۦٓ إِلَىٰ يَوۡمِ",false]]},{"l":[[37,144,"يُبۡعَثُونَ",true],[37,145,"۞ فَنَبَذۡنَٰهُ بِٱلۡعَرَآءِ وَهُوَ سَقِيمࣱ",true],[37,146,"وَأَنۢبَتۡنَا",false]]},{"l":[[37,146,"عَلَيۡهِ شَجَرَةࣰ مِّن يَقۡطِينࣲ",true],[37,147,"وَأَرۡسَلۡنَٰهُ إِلَىٰ مِاْئَةِ أَلۡفٍ أَوۡ",false]]},{"l":[[37,147,"يَزِيدُونَ",true],[37,148,"فَـَٔامَنُواْ فَمَتَّعۡنَٰهُمۡ إِلَىٰ حِينࣲ",true],[37,149,"فَٱسۡتَفۡتِهِمۡ",false]]},{"l":[[37,149,"أَلِرَبِّكَ ٱلۡبَنَاتُ وَلَهُمُ ٱلۡبَنُونَ",true],[37,150,"أَمۡ خَلَقۡنَا ٱلۡمَلَٰٓئِكَةَ إِنَٰثࣰا",false]]},{"l":[[37,150,"وَهُمۡ شَٰهِدُونَ",true],[37,151,"أَلَآ إِنَّهُم مِّنۡ إِفۡكِهِمۡ لَيَقُولُونَ",true],[37,152,"وَلَدَ",false]]},{"l":[[37,152,"ٱللَّهُ وَإِنَّهُمۡ لَكَٰذِبُونَ",true],[37,153,"أَصۡطَفَى ٱلۡبَنَاتِ عَلَى ٱلۡبَنِينَ",true]]}]}