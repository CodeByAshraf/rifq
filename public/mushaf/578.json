{"p":578,"j":29,"rows":[{"l":[[75,20,"كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ",true],[75,21,"وَتَذَرُونَ ٱلۡأٓخِرَةَ",true],[75,22,"وُجُوهࣱ يَوۡمَئِذࣲ",false]]},{"l":[[75,22,"نَّاضِرَةٌ",true],[75,23,"إِلَىٰ رَبِّهَا نَاظِرَةࣱ",true],[75,24,"وَوُجُوهࣱ يَوۡمَئِذِۭ بَاسِرَةࣱ",true],[75,25,"تَظُنُّ أَن يُفۡعَلَ",false]]},{"l":[[75,25,"بِهَا فَاقِرَةࣱ",true],[75,26,"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ",true],[75,27,"وَقِيلَ مَنۡۜ رَاقࣲ",true],[75,28,"وَظَنَّ أَنَّهُ",false]]},{"l":[[75,28,"ٱلۡفِرَاقُ",true],[75,29,"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ",true],[75,30,"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ",true]]},{"l":[[75,31,"فَلَا صَدَّقَ وَلَا صَلَّىٰ",true],[75,32,"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ",true],[75,33,"ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ",false]]},{"l":[[75,33,"يَتَمَطَّىٰٓ",true],[75,34,"أَوۡلَىٰ لَكَ فَأَوۡلَىٰ",true],[75,35,"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ",true],[75,36,"أَيَحۡسَبُ",false]]},{"l":[[75,36,"ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى",true],[75,37,"أَلَمۡ يَكُ نُطۡفَةࣰ مِّن مَّنِيࣲّ يُمۡنَىٰ",true]]},{"l":[[75,38,"ثُمَّ كَانَ عَلَقَةࣰ فَخَلَقَ فَسَوَّىٰ",true],[75,39,"فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ",false]]},{"l":[[75,39,"وَٱلۡأُنثَىٰٓ",true],[75,40,"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ",true]]},{"h":76},{"b":1},{"l":[[76,1,"هَلۡ أَتَىٰ عَلَى ٱلۡإِنسَٰنِ حِينࣱ مِّنَ ٱلدَّهۡرِ لَمۡ يَكُن شَيۡـࣰٔا مَّذۡكُورًا",true],[76,2,"إِنَّا خَلَقۡنَا",false]]},{"l":[[76,2,"ٱلۡإِنسَٰنَ مِن نُّطۡفَةٍ أَمۡشَاجࣲ نَّبۡتَلِيهِ فَجَعَلۡنَٰهُ سَمِيعَۢا بَصِيرًا",true],[76,3,"إِنَّا",false]]},{"l":[[76,3,"هَدَيۡنَٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرࣰا وَإِمَّا كَفُورًا",true],[76,4,"إِنَّآ أَعۡتَدۡنَا لِلۡكَٰفِرِينَ سَلَٰسِلَاْ",false]]},{"l":[[76,4,"وَأَغۡلَٰلࣰا وَسَعِيرًا",true],[76,5,"إِنَّ ٱلۡأَبۡرَارَ يَشۡرَبُونَ مِن كَأۡسࣲ كَانَ مِزَاجُهَا كَافُورًا",true]]}]}