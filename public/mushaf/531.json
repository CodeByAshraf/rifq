{"p":531,"j":27,"rows":[{"l":[[54,50,"وَمَآ أَمۡرُنَآ إِلَّا وَٰحِدَةࣱ كَلَمۡحِۭ بِٱلۡبَصَرِ",true],[54,51,"وَلَقَدۡ أَهۡلَكۡنَآ",false]]},{"l":[[54,51,"أَشۡيَاعَكُمۡ فَهَلۡ مِن مُّدَّكِرࣲ",true],[54,52,"وَكُلُّ شَيۡءࣲ فَعَلُوهُ فِي ٱلزُّبُرِ",true]]},{"l":[[54,53,"وَكُلُّ صَغِيرࣲ وَكَبِيرࣲ مُّسۡتَطَرٌ",true],[54,54,"إِنَّ ٱلۡمُتَّقِينَ فِي",false]]},{"l":[[54,54,"جَنَّٰتࣲ وَنَهَرࣲ",true],[54,55,"فِي مَقۡعَدِ صِدۡقٍ عِندَ مَلِيكࣲ مُّقۡتَدِرِۭ",true]]},{"h":55},{"b":1},{"l":[[55,1,"ٱلرَّحۡمَٰنُ",true],[55,2,"عَلَّمَ ٱلۡقُرۡءَانَ",true],[55,3,"خَلَقَ ٱلۡإِنسَٰنَ",true],[55,4,"عَلَّمَهُ ٱلۡبَيَانَ",true]]},{"l":[[55,5,"ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانࣲ",true],[55,6,"وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ",true]]},{"l":[[55,7,"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ",true],[55,8,"أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ",true]]},{"l":[[55,9,"وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ",true],[55,10,"وَٱلۡأَرۡضَ",false]]},{"l":[[55,10,"وَضَعَهَا لِلۡأَنَامِ",true],[55,11,"فِيهَا فَٰكِهَةࣱ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ",true]]},{"l":[[55,12,"وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ",true],[55,13,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",true]]},{"l":[[55,14,"خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلࣲ كَٱلۡفَخَّارِ",true],[55,15,"وَخَلَقَ ٱلۡجَآنَّ مِن",false]]},{"l":[[55,15,"مَّارِجࣲ مِّن نَّارࣲ",true],[55,16,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",true],[55,17,"رَبُّ",false]]},{"l":[[55,17,"ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ",true],[55,18,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",true]]}]}