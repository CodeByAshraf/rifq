{"p":583,"j":30,"rows":[{"l":[[78,31,"إِنَّ لِلۡمُتَّقِينَ مَفَازًا",true],[78,32,"حَدَآئِقَ وَأَعۡنَٰبࣰا",true],[78,33,"وَكَوَاعِبَ أَتۡرَابࣰا",true],[78,34,"وَكَأۡسࣰا",false]]},{"l":[[78,34,"دِهَاقࣰا",true],[78,35,"لَّا يَسۡمَعُونَ فِيهَا لَغۡوࣰا وَلَا كِذَّٰبࣰا",true],[78,36,"جَزَآءࣰ مِّن رَّبِّكَ عَطَآءً",false]]},{"l":[[78,36,"حِسَابࣰا",true],[78,37,"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ",false]]},{"l":[[78,37,"مِنۡهُ خِطَابࣰا",true],[78,38,"يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفࣰّاۖ لَّا يَتَكَلَّمُونَ",false]]},{"l":[[78,38,"إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابࣰا",true],[78,39,"ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن",false]]},{"l":[[78,39,"شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",true],[78,40,"إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابࣰا قَرِيبࣰا يَوۡمَ يَنظُرُ",false]]},{"l":[[78,40,"ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا",true]]},{"h":79},{"b":1},{"l":[[79,1,"وَٱلنَّٰزِعَٰتِ غَرۡقࣰا",true],[79,2,"وَٱلنَّٰشِطَٰتِ نَشۡطࣰا",true],[79,3,"وَٱلسَّٰبِحَٰتِ سَبۡحࣰا",true]]},{"l":[[79,4,"فَٱلسَّٰبِقَٰتِ سَبۡقࣰا",true],[79,5,"فَٱلۡمُدَبِّرَٰتِ أَمۡرࣰا",true],[79,6,"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ",true]]},{"l":[[79,7,"تَتۡبَعُهَا ٱلرَّادِفَةُ",true],[79,8,"قُلُوبࣱ يَوۡمَئِذࣲ وَاجِفَةٌ",true],[79,9,"أَبۡصَٰرُهَا خَٰشِعَةࣱ",true]]},{"l":[[79,10,"يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ",true],[79,11,"أَءِذَا كُنَّا عِظَٰمࣰا نَّخِرَةࣰ",true],[79,12,"قَالُواْ",false]]},{"l":[[79,12,"تِلۡكَ إِذࣰا كَرَّةٌ خَاسِرَةࣱ",true],[79,13,"فَإِنَّمَا هِيَ زَجۡرَةࣱ وَٰحِدَةࣱ",true],[79,14,"فَإِذَا هُم بِٱلسَّاهِرَةِ",true]]},{"l":[[79,15,"هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",true],[79,16,"إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى",true]]}]}