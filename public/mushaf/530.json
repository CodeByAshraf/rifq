{"p":530,"j":27,"rows":[{"l":[[54,28,"وَنَبِّئۡهُمۡ أَنَّ ٱلۡمَآءَ قِسۡمَةُۢ بَيۡنَهُمۡۖ كُلُّ شِرۡبࣲ مُّحۡتَضَرࣱ",true],[54,29,"فَنَادَوۡاْ صَاحِبَهُمۡ",false]]},{"l":[[54,29,"فَتَعَاطَىٰ فَعَقَرَ",true],[54,30,"فَكَيۡفَ كَانَ عَذَابِي وَنُذُرِ",true],[54,31,"إِنَّآ أَرۡسَلۡنَا عَلَيۡهِمۡ",false]]},{"l":[[54,31,"صَيۡحَةࣰ وَٰحِدَةࣰ فَكَانُواْ كَهَشِيمِ ٱلۡمُحۡتَظِرِ",true],[54,32,"وَلَقَدۡ يَسَّرۡنَا ٱلۡقُرۡءَانَ",false]]},{"l":[[54,32,"لِلذِّكۡرِ فَهَلۡ مِن مُّدَّكِرࣲ",true],[54,33,"كَذَّبَتۡ قَوۡمُ لُوطِۭ بِٱلنُّذُرِ",true],[54,34,"إِنَّآ أَرۡسَلۡنَا",false]]},{"l":[[54,34,"عَلَيۡهِمۡ حَاصِبًا إِلَّآ ءَالَ لُوطࣲۖ نَّجَّيۡنَٰهُم بِسَحَرࣲ",true],[54,35,"نِّعۡمَةࣰ مِّنۡ عِندِنَاۚ",false]]},{"l":[[54,35,"كَذَٰلِكَ نَجۡزِي مَن شَكَرَ",true],[54,36,"وَلَقَدۡ أَنذَرَهُم بَطۡشَتَنَا فَتَمَارَوۡاْ",false]]},{"l":[[54,36,"بِٱلنُّذُرِ",true],[54,37,"وَلَقَدۡ رَٰوَدُوهُ عَن ضَيۡفِهِۦ فَطَمَسۡنَآ أَعۡيُنَهُمۡ فَذُوقُواْ",false]]},{"l":[[54,37,"عَذَابِي وَنُذُرِ",true],[54,38,"وَلَقَدۡ صَبَّحَهُم بُكۡرَةً عَذَابࣱ مُّسۡتَقِرࣱّ",true],[54,39,"فَذُوقُواْ",false]]},{"l":[[54,39,"عَذَابِي وَنُذُرِ",true],[54,40,"وَلَقَدۡ يَسَّرۡنَا ٱلۡقُرۡءَانَ لِلذِّكۡرِ فَهَلۡ مِن مُّدَّكِرࣲ",true]]},{"l":[[54,41,"وَلَقَدۡ جَآءَ ءَالَ فِرۡعَوۡنَ ٱلنُّذُرُ",true],[54,42,"كَذَّبُواْ بِـَٔايَٰتِنَا كُلِّهَا فَأَخَذۡنَٰهُمۡ",false]]},{"l":[[54,42,"أَخۡذَ عَزِيزࣲ مُّقۡتَدِرٍ",true],[54,43,"أَكُفَّارُكُمۡ خَيۡرࣱ مِّنۡ أُوْلَٰٓئِكُمۡ أَمۡ لَكُم بَرَآءَةࣱ",false]]},{"l":[[54,43,"فِي ٱلزُّبُرِ",true],[54,44,"أَمۡ يَقُولُونَ نَحۡنُ جَمِيعࣱ مُّنتَصِرࣱ",true],[54,45,"سَيُهۡزَمُ ٱلۡجَمۡعُ",false]]},{"l":[[54,45,"وَيُوَلُّونَ ٱلدُّبُرَ",true],[54,46,"بَلِ ٱلسَّاعَةُ مَوۡعِدُهُمۡ وَٱلسَّاعَةُ أَدۡهَىٰ وَأَمَرُّ",true]]},{"l":[[54,47,"إِنَّ ٱلۡمُجۡرِمِينَ فِي ضَلَٰلࣲ وَسُعُرࣲ",true],[54,48,"يَوۡمَ يُسۡحَبُونَ فِي ٱلنَّارِ عَلَىٰ",false]]},{"l":[[54,48,"وُجُوهِهِمۡ ذُوقُواْ مَسَّ سَقَرَ",true],[54,49,"إِنَّا كُلَّ شَيۡءٍ خَلَقۡنَٰهُ بِقَدَرࣲ",true]]}]}