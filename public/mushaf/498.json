{"p":498,"j":25,"rows":[{"l":[[44,40,"إِنَّ يَوۡمَ ٱلۡفَصۡلِ مِيقَٰتُهُمۡ أَجۡمَعِينَ",true],[44,41,"يَوۡمَ لَا يُغۡنِي",false]]},{"l":[[44,41,"مَوۡلًى عَن مَّوۡلࣰى شَيۡـࣰٔا وَلَا هُمۡ يُنصَرُونَ",true],[44,42,"إِلَّا مَن رَّحِمَ ٱللَّهُۚ",false]]},{"l":[[44,42,"إِنَّهُۥ هُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",true],[44,43,"إِنَّ شَجَرَتَ ٱلزَّقُّومِ",true]]},{"l":[[44,44,"طَعَامُ ٱلۡأَثِيمِ",true],[44,45,"كَٱلۡمُهۡلِ يَغۡلِي فِي ٱلۡبُطُونِ",true]]},{"l":[[44,46,"كَغَلۡيِ ٱلۡحَمِيمِ",true],[44,47,"خُذُوهُ فَٱعۡتِلُوهُ إِلَىٰ سَوَآءِ",false]]},{"l":[[44,47,"ٱلۡجَحِيمِ",true],[44,48,"ثُمَّ صُبُّواْ فَوۡقَ رَأۡسِهِۦ مِنۡ عَذَابِ",false]]},{"l":[[44,48,"ٱلۡحَمِيمِ",true],[44,49,"ذُقۡ إِنَّكَ أَنتَ ٱلۡعَزِيزُ ٱلۡكَرِيمُ",true]]},{"l":[[44,50,"إِنَّ هَٰذَا مَا كُنتُم بِهِۦ تَمۡتَرُونَ",true],[44,51,"إِنَّ ٱلۡمُتَّقِينَ",false]]},{"l":[[44,51,"فِي مَقَامٍ أَمِينࣲ",true],[44,52,"فِي جَنَّٰتࣲ وَعُيُونࣲ",true],[44,53,"يَلۡبَسُونَ",false]]},{"l":[[44,53,"مِن سُندُسࣲ وَإِسۡتَبۡرَقࣲ مُّتَقَٰبِلِينَ",true],[44,54,"كَذَٰلِكَ",false]]},{"l":[[44,54,"وَزَوَّجۡنَٰهُم بِحُورٍ عِينࣲ",true],[44,55,"يَدۡعُونَ فِيهَا بِكُلِّ",false]]},{"l":[[44,55,"فَٰكِهَةٍ ءَامِنِينَ",true],[44,56,"لَا يَذُوقُونَ فِيهَا ٱلۡمَوۡتَ إِلَّا",false]]},{"l":[[44,56,"ٱلۡمَوۡتَةَ ٱلۡأُولَىٰۖ وَوَقَىٰهُمۡ عَذَابَ ٱلۡجَحِيمِ",true],[44,57,"فَضۡلࣰا مِّن",false]]},{"l":[[44,57,"رَّبِّكَۚ ذَٰلِكَ هُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ",true],[44,58,"فَإِنَّمَا يَسَّرۡنَٰهُ بِلِسَانِكَ",false]]},{"l":[[44,58,"لَعَلَّهُمۡ يَتَذَكَّرُونَ",true],[44,59,"فَٱرۡتَقِبۡ إِنَّهُم مُّرۡتَقِبُونَ",true]]}]}