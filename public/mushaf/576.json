{"p":576,"j":29,"rows":[{"l":[[74,19,"فَقُتِلَ كَيۡفَ قَدَّرَ",true],[74,20,"ثُمَّ قُتِلَ كَيۡفَ قَدَّرَ",true],[74,21,"ثُمَّ نَظَرَ",true],[74,22,"ثُمَّ عَبَسَ وَبَسَرَ",true]]},{"l":[[74,23,"ثُمَّ أَدۡبَرَ وَٱسۡتَكۡبَرَ",true],[74,24,"فَقَالَ إِنۡ هَٰذَآ إِلَّا سِحۡرࣱ يُؤۡثَرُ",true],[74,25,"إِنۡ هَٰذَآ",false]]},{"l":[[74,25,"إِلَّا قَوۡلُ ٱلۡبَشَرِ",true],[74,26,"سَأُصۡلِيهِ سَقَرَ",true],[74,27,"وَمَآ أَدۡرَىٰكَ مَا سَقَرُ",true]]},{"l":[[74,28,"لَا تُبۡقِي وَلَا تَذَرُ",true],[74,29,"لَوَّاحَةࣱ لِّلۡبَشَرِ",true],[74,30,"عَلَيۡهَا تِسۡعَةَ عَشَرَ",true],[74,31,"وَمَا جَعَلۡنَآ",false]]},{"l":[[74,31,"أَصۡحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةࣰۖ وَمَا جَعَلۡنَا عِدَّتَهُمۡ إِلَّا فِتۡنَةࣰ لِّلَّذِينَ كَفَرُواْ",false]]},{"l":[[74,31,"لِيَسۡتَيۡقِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَيَزۡدَادَ ٱلَّذِينَ ءَامَنُوٓاْ إِيمَٰنࣰا وَلَا يَرۡتَابَ",false]]},{"l":[[74,31,"ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَٱلۡمُؤۡمِنُونَ وَلِيَقُولَ ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضࣱ",false]]},{"l":[[74,31,"وَٱلۡكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلࣰاۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ",false]]},{"l":[[74,31,"وَيَهۡدِي مَن يَشَآءُۚ وَمَا يَعۡلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۚ وَمَا هِيَ إِلَّا ذِكۡرَىٰ",false]]},{"l":[[74,31,"لِلۡبَشَرِ",true],[74,32,"كَلَّا وَٱلۡقَمَرِ",true],[74,33,"وَٱلَّيۡلِ إِذۡ أَدۡبَرَ",true],[74,34,"وَٱلصُّبۡحِ إِذَآ أَسۡفَرَ",true],[74,35,"إِنَّهَا",false]]},{"l":[[74,35,"لَإِحۡدَى ٱلۡكُبَرِ",true],[74,36,"نَذِيرࣰا لِّلۡبَشَرِ",true],[74,37,"لِمَن شَآءَ مِنكُمۡ أَن يَتَقَدَّمَ أَوۡ يَتَأَخَّرَ",true]]},{"l":[[74,38,"كُلُّ نَفۡسِۭ بِمَا كَسَبَتۡ رَهِينَةٌ",true],[74,39,"إِلَّآ أَصۡحَٰبَ ٱلۡيَمِينِ",true],[74,40,"فِي جَنَّٰتࣲ",false]]},{"l":[[74,40,"يَتَسَآءَلُونَ",true],[74,41,"عَنِ ٱلۡمُجۡرِمِينَ",true],[74,42,"مَا سَلَكَكُمۡ فِي سَقَرَ",true],[74,43,"قَالُواْ لَمۡ نَكُ",false]]},{"l":[[74,43,"مِنَ ٱلۡمُصَلِّينَ",true],[74,44,"وَلَمۡ نَكُ نُطۡعِمُ ٱلۡمِسۡكِينَ",true],[74,45,"وَكُنَّا نَخُوضُ مَعَ",false]]},{"l":[[74,45,"ٱلۡخَآئِضِينَ",true],[74,46,"وَكُنَّا نُكَذِّبُ بِيَوۡمِ ٱلدِّينِ",true],[74,47,"حَتَّىٰٓ أَتَىٰنَا ٱلۡيَقِينُ",true]]}]}