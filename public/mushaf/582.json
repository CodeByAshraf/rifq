{"p":582,"j":30,"rows":[{"h":78},{"b":1},{"l":[[78,1,"عَمَّ يَتَسَآءَلُونَ",true],[78,2,"عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ",true],[78,3,"ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ",true]]},{"l":[[78,4,"كَلَّا سَيَعۡلَمُونَ",true],[78,5,"ثُمَّ كَلَّا سَيَعۡلَمُونَ",true],[78,6,"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدࣰا",true]]},{"l":[[78,7,"وَٱلۡجِبَالَ أَوۡتَادࣰا",true],[78,8,"وَخَلَقۡنَٰكُمۡ أَزۡوَٰجࣰا",true],[78,9,"وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتࣰا",true]]},{"l":[[78,10,"وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسࣰا",true],[78,11,"وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشࣰا",true],[78,12,"وَبَنَيۡنَا",false]]},{"l":[[78,12,"فَوۡقَكُمۡ سَبۡعࣰا شِدَادࣰا",true],[78,13,"وَجَعَلۡنَا سِرَاجࣰا وَهَّاجࣰا",true],[78,14,"وَأَنزَلۡنَا مِنَ",false]]},{"l":[[78,14,"ٱلۡمُعۡصِرَٰتِ مَآءࣰ ثَجَّاجࣰا",true],[78,15,"لِّنُخۡرِجَ بِهِۦ حَبࣰّا وَنَبَاتࣰا",true],[78,16,"وَجَنَّٰتٍ",false]]},{"l":[[78,16,"أَلۡفَافًا",true],[78,17,"إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتࣰا",true],[78,18,"يَوۡمَ يُنفَخُ فِي ٱلصُّورِ",false]]},{"l":[[78,18,"فَتَأۡتُونَ أَفۡوَاجࣰا",true],[78,19,"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبࣰا",true],[78,20,"وَسُيِّرَتِ",false]]},{"l":[[78,20,"ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا",true],[78,21,"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادࣰا",true],[78,22,"لِّلطَّٰغِينَ",false]]},{"l":[[78,22,"مَـَٔابࣰا",true],[78,23,"لَّٰبِثِينَ فِيهَآ أَحۡقَابࣰا",true],[78,24,"لَّا يَذُوقُونَ فِيهَا بَرۡدࣰا وَلَا",false]]},{"l":[[78,24,"شَرَابًا",true],[78,25,"إِلَّا حَمِيمࣰا وَغَسَّاقࣰا",true],[78,26,"جَزَآءࣰ وِفَاقًا",true],[78,27,"إِنَّهُمۡ كَانُواْ",false]]},{"l":[[78,27,"لَا يَرۡجُونَ حِسَابࣰا",true],[78,28,"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابࣰا",true],[78,29,"وَكُلَّ شَيۡءٍ",false]]},{"l":[[78,29,"أَحۡصَيۡنَٰهُ كِتَٰبࣰا",true],[78,30,"فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا",true]]}]}