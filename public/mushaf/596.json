{"p":596,"j":30,"rows":[{"l":[[92,10,"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ",true],[92,11,"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",true],[92,12,"إِنَّ عَلَيۡنَا",false]]},{"l":[[92,12,"لَلۡهُدَىٰ",true],[92,13,"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ",true],[92,14,"فَأَنذَرۡتُكُمۡ نَارࣰا تَلَظَّىٰ",true]]},{"l":[[92,15,"لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى",true],[92,16,"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ",true],[92,17,"وَسَيُجَنَّبُهَا",false]]},{"l":[[92,17,"ٱلۡأَتۡقَى",true],[92,18,"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ",true],[92,19,"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةࣲ",false]]},{"l":[[92,19,"تُجۡزَىٰٓ",true],[92,20,"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ",true],[92,21,"وَلَسَوۡفَ يَرۡضَىٰ",true]]},{"h":93},{"b":1},{"l":[[93,1,"وَٱلضُّحَىٰ",true],[93,2,"وَٱلَّيۡلِ إِذَا سَجَىٰ",true],[93,3,"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",true]]},{"l":[[93,4,"وَلَلۡأٓخِرَةُ خَيۡرࣱ لَّكَ مِنَ ٱلۡأُولَىٰ",true],[93,5,"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ",false]]},{"l":[[93,5,"فَتَرۡضَىٰٓ",true],[93,6,"أَلَمۡ يَجِدۡكَ يَتِيمࣰا فَـَٔاوَىٰ",true],[93,7,"وَوَجَدَكَ ضَآلࣰّا فَهَدَىٰ",true]]},{"l":[[93,8,"وَوَجَدَكَ عَآئِلࣰا فَأَغۡنَىٰ",true],[93,9,"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ",true]]},{"l":[[93,10,"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ",true],[93,11,"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ",true]]},{"h":94},{"b":1},{"l":[[94,1,"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ",true],[94,2,"وَوَضَعۡنَا عَنكَ وِزۡرَكَ",true]]}]}