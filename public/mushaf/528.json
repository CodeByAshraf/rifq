{"p":528,"j":27,"rows":[{"l":[[53,45,"وَأَنَّهُۥ خَلَقَ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰ",true],[53,46,"مِن نُّطۡفَةٍ إِذَا تُمۡنَىٰ",true]]},{"l":[[53,47,"وَأَنَّ عَلَيۡهِ ٱلنَّشۡأَةَ ٱلۡأُخۡرَىٰ",true],[53,48,"وَأَنَّهُۥ هُوَ أَغۡنَىٰ وَأَقۡنَىٰ",true],[53,49,"وَأَنَّهُۥ هُوَ",false]]},{"l":[[53,49,"رَبُّ ٱلشِّعۡرَىٰ",true],[53,50,"وَأَنَّهُۥٓ أَهۡلَكَ عَادًا ٱلۡأُولَىٰ",true],[53,51,"وَثَمُودَاْ فَمَآ",false]]},{"l":[[53,51,"أَبۡقَىٰ",true],[53,52,"وَقَوۡمَ نُوحࣲ مِّن قَبۡلُۖ إِنَّهُمۡ كَانُواْ هُمۡ أَظۡلَمَ وَأَطۡغَىٰ",true]]},{"l":[[53,53,"وَٱلۡمُؤۡتَفِكَةَ أَهۡوَىٰ",true],[53,54,"فَغَشَّىٰهَا مَا غَشَّىٰ",true],[53,55,"فَبِأَيِّ ءَالَآءِ رَبِّكَ",false]]},{"l":[[53,55,"تَتَمَارَىٰ",true],[53,56,"هَٰذَا نَذِيرࣱ مِّنَ ٱلنُّذُرِ ٱلۡأُولَىٰٓ",true],[53,57,"أَزِفَتِ ٱلۡأٓزِفَةُ",true]]},{"l":[[53,58,"لَيۡسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ",true],[53,59,"أَفَمِنۡ هَٰذَا ٱلۡحَدِيثِ",false]]},{"l":[[53,59,"تَعۡجَبُونَ",true],[53,60,"وَتَضۡحَكُونَ وَلَا تَبۡكُونَ",true],[53,61,"وَأَنتُمۡ سَٰمِدُونَ",true]]},{"l":[[53,62,"فَٱسۡجُدُواْۤ لِلَّهِۤ وَٱعۡبُدُواْ۩",true]]},{"h":54},{"b":1},{"l":[[54,1,"ٱقۡتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلۡقَمَرُ",true],[54,2,"وَإِن يَرَوۡاْ ءَايَةࣰ يُعۡرِضُواْ وَيَقُولُواْ",false]]},{"l":[[54,2,"سِحۡرࣱ مُّسۡتَمِرࣱّ",true],[54,3,"وَكَذَّبُواْ وَٱتَّبَعُوٓاْ أَهۡوَآءَهُمۡۚ وَكُلُّ أَمۡرࣲ مُّسۡتَقِرࣱّ",true]]},{"l":[[54,4,"وَلَقَدۡ جَآءَهُم مِّنَ ٱلۡأَنۢبَآءِ مَا فِيهِ مُزۡدَجَرٌ",true],[54,5,"حِكۡمَةُۢ بَٰلِغَةࣱۖ فَمَا تُغۡنِ",false]]},{"l":[[54,5,"ٱلنُّذُرُ",true],[54,6,"فَتَوَلَّ عَنۡهُمۡۘ يَوۡمَ يَدۡعُ ٱلدَّاعِ إِلَىٰ شَيۡءࣲ نُّكُرٍ",true]]}]}