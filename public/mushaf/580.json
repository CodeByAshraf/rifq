{"p":580,"j":29,"rows":[{"l":[[76,26,"وَمِنَ ٱلَّيۡلِ فَٱسۡجُدۡ لَهُۥ وَسَبِّحۡهُ لَيۡلࣰا طَوِيلًا",true],[76,27,"إِنَّ هَٰٓؤُلَآءِ",false]]},{"l":[[76,27,"يُحِبُّونَ ٱلۡعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمۡ يَوۡمࣰا ثَقِيلࣰا",true],[76,28,"نَّحۡنُ خَلَقۡنَٰهُمۡ",false]]},{"l":[[76,28,"وَشَدَدۡنَآ أَسۡرَهُمۡۖ وَإِذَا شِئۡنَا بَدَّلۡنَآ أَمۡثَٰلَهُمۡ تَبۡدِيلًا",true],[76,29,"إِنَّ",false]]},{"l":[[76,29,"هَٰذِهِۦ تَذۡكِرَةࣱۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلࣰا",true],[76,30,"وَمَا تَشَآءُونَ",false]]},{"l":[[76,30,"إِلَّآ أَن يَشَآءَ ٱللَّهُۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمࣰا",true],[76,31,"يُدۡخِلُ",false]]},{"l":[[76,31,"مَن يَشَآءُ فِي رَحۡمَتِهِۦۚ وَٱلظَّٰلِمِينَ أَعَدَّ لَهُمۡ عَذَابًا أَلِيمَۢا",true]]},{"h":77},{"b":1},{"l":[[77,1,"وَٱلۡمُرۡسَلَٰتِ عُرۡفࣰا",true],[77,2,"فَٱلۡعَٰصِفَٰتِ عَصۡفࣰا",true],[77,3,"وَٱلنَّٰشِرَٰتِ نَشۡرࣰا",true]]},{"l":[[77,4,"فَٱلۡفَٰرِقَٰتِ فَرۡقࣰا",true],[77,5,"فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا",true],[77,6,"عُذۡرًا أَوۡ نُذۡرًا",true],[77,7,"إِنَّمَا",false]]},{"l":[[77,7,"تُوعَدُونَ لَوَٰقِعࣱ",true],[77,8,"فَإِذَا ٱلنُّجُومُ طُمِسَتۡ",true],[77,9,"وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ",true]]},{"l":[[77,10,"وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ",true],[77,11,"وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ",true],[77,12,"لِأَيِّ يَوۡمٍ أُجِّلَتۡ",true]]},{"l":[[77,13,"لِيَوۡمِ ٱلۡفَصۡلِ",true],[77,14,"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ",true],[77,15,"وَيۡلࣱ يَوۡمَئِذࣲ",false]]},{"l":[[77,15,"لِّلۡمُكَذِّبِينَ",true],[77,16,"أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ",true],[77,17,"ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ",true]]},{"l":[[77,18,"كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ",true],[77,19,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ",true]]}]}