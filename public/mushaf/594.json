{"p":594,"j":30,"rows":[{"l":[[89,23,"وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذࣲ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ",false]]},{"l":[[89,23,"لَهُ ٱلذِّكۡرَىٰ",true],[89,24,"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي",true],[89,25,"فَيَوۡمَئِذࣲ",false]]},{"l":[[89,25,"لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدࣱ",true],[89,26,"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدࣱ",true],[89,27,"يَٰٓأَيَّتُهَا",false]]},{"l":[[89,27,"ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ",true],[89,28,"ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةࣰ مَّرۡضِيَّةࣰ",true]]},{"l":[[89,29,"فَٱدۡخُلِي فِي عِبَٰدِي",true],[89,30,"وَٱدۡخُلِي جَنَّتِي",true]]},{"h":90},{"b":1},{"l":[[90,1,"لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ",true],[90,2,"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ",true],[90,3,"وَوَالِدࣲ وَمَا وَلَدَ",true]]},{"l":[[90,4,"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ",true],[90,5,"أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ",false]]},{"l":[[90,5,"أَحَدࣱ",true],[90,6,"يَقُولُ أَهۡلَكۡتُ مَالࣰا لُّبَدًا",true],[90,7,"أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ",true]]},{"l":[[90,8,"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ",true],[90,9,"وَلِسَانࣰا وَشَفَتَيۡنِ",true],[90,10,"وَهَدَيۡنَٰهُ",false]]},{"l":[[90,10,"ٱلنَّجۡدَيۡنِ",true],[90,11,"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ",true],[90,12,"وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ",true]]},{"l":[[90,13,"فَكُّ رَقَبَةٍ",true],[90,14,"أَوۡ إِطۡعَٰمࣱ فِي يَوۡمࣲ ذِي مَسۡغَبَةࣲ",true],[90,15,"يَتِيمࣰا ذَا مَقۡرَبَةٍ",true]]},{"l":[[90,16,"أَوۡ مِسۡكِينࣰا ذَا مَتۡرَبَةࣲ",true],[90,17,"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ",false]]},{"l":[[90,17,"بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ",true],[90,18,"أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ",true]]}]}