{"p":592,"j":30,"rows":[{"l":[[87,11,"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى",true],[87,12,"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ",true],[87,13,"ثُمَّ لَا يَمُوتُ",false]]},{"l":[[87,13,"فِيهَا وَلَا يَحۡيَىٰ",true],[87,14,"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ",true],[87,15,"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ",true]]},{"l":[[87,16,"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا",true],[87,17,"وَٱلۡأٓخِرَةُ خَيۡرࣱ وَأَبۡقَىٰٓ",true],[87,18,"إِنَّ",false]]},{"l":[[87,18,"هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ",true],[87,19,"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ",true]]},{"h":88},{"b":1},{"l":[[88,1,"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ",true],[88,2,"وُجُوهࣱ يَوۡمَئِذٍ خَٰشِعَةٌ",true],[88,3,"عَامِلَةࣱ",false]]},{"l":[[88,3,"نَّاصِبَةࣱ",true],[88,4,"تَصۡلَىٰ نَارًا حَامِيَةࣰ",true],[88,5,"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةࣲ",true],[88,6,"لَّيۡسَ",false]]},{"l":[[88,6,"لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعࣲ",true],[88,7,"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعࣲ",true],[88,8,"وُجُوهࣱ",false]]},{"l":[[88,8,"يَوۡمَئِذࣲ نَّاعِمَةࣱ",true],[88,9,"لِّسَعۡيِهَا رَاضِيَةࣱ",true],[88,10,"فِي جَنَّةٍ عَالِيَةࣲ",true],[88,11,"لَّا تَسۡمَعُ",false]]},{"l":[[88,11,"فِيهَا لَٰغِيَةࣰ",true],[88,12,"فِيهَا عَيۡنࣱ جَارِيَةࣱ",true],[88,13,"فِيهَا سُرُرࣱ مَّرۡفُوعَةࣱ",true],[88,14,"وَأَكۡوَابࣱ",false]]},{"l":[[88,14,"مَّوۡضُوعَةࣱ",true],[88,15,"وَنَمَارِقُ مَصۡفُوفَةࣱ",true],[88,16,"وَزَرَابِيُّ مَبۡثُوثَةٌ",true],[88,17,"أَفَلَا يَنظُرُونَ",false]]},{"l":[[88,17,"إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ",true],[88,18,"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ",true],[88,19,"وَإِلَى",false]]},{"l":[[88,19,"ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ",true],[88,20,"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ",true]]},{"l":[[88,21,"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرࣱ",true],[88,22,"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ",true]]}]}