{"p":523,"j":27,"rows":[{"l":[[51,52,"كَذَٰلِكَ مَآ أَتَى ٱلَّذِينَ مِن قَبۡلِهِم مِّن رَّسُولٍ إِلَّا قَالُواْ سَاحِرٌ",false]]},{"l":[[51,52,"أَوۡ مَجۡنُونٌ",true],[51,53,"أَتَوَاصَوۡاْ بِهِۦۚ بَلۡ هُمۡ قَوۡمࣱ طَاغُونَ",true],[51,54,"فَتَوَلَّ عَنۡهُمۡ",false]]},{"l":[[51,54,"فَمَآ أَنتَ بِمَلُومࣲ",true],[51,55,"وَذَكِّرۡ فَإِنَّ ٱلذِّكۡرَىٰ تَنفَعُ ٱلۡمُؤۡمِنِينَ",true],[51,56,"وَمَا",false]]},{"l":[[51,56,"خَلَقۡتُ ٱلۡجِنَّ وَٱلۡإِنسَ إِلَّا لِيَعۡبُدُونِ",true],[51,57,"مَآ أُرِيدُ مِنۡهُم مِّن رِّزۡقࣲ",false]]},{"l":[[51,57,"وَمَآ أُرِيدُ أَن يُطۡعِمُونِ",true],[51,58,"إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلۡقُوَّةِ ٱلۡمَتِينُ",true]]},{"l":[[51,59,"فَإِنَّ لِلَّذِينَ ظَلَمُواْ ذَنُوبࣰا مِّثۡلَ ذَنُوبِ أَصۡحَٰبِهِمۡ فَلَا",false]]},{"l":[[51,59,"يَسۡتَعۡجِلُونِ",true],[51,60,"فَوَيۡلࣱ لِّلَّذِينَ كَفَرُواْ مِن يَوۡمِهِمُ ٱلَّذِي يُوعَدُونَ",true]]},{"h":52},{"b":1},{"l":[[52,1,"وَٱلطُّورِ",true],[52,2,"وَكِتَٰبࣲ مَّسۡطُورࣲ",true],[52,3,"فِي رَقࣲّ مَّنشُورࣲ",true],[52,4,"وَٱلۡبَيۡتِ",false]]},{"l":[[52,4,"ٱلۡمَعۡمُورِ",true],[52,5,"وَٱلسَّقۡفِ ٱلۡمَرۡفُوعِ",true],[52,6,"وَٱلۡبَحۡرِ ٱلۡمَسۡجُورِ",true],[52,7,"إِنَّ",false]]},{"l":[[52,7,"عَذَابَ رَبِّكَ لَوَٰقِعࣱ",true],[52,8,"مَّا لَهُۥ مِن دَافِعࣲ",true],[52,9,"يَوۡمَ تَمُورُ ٱلسَّمَآءُ",false]]},{"l":[[52,9,"مَوۡرࣰا",true],[52,10,"وَتَسِيرُ ٱلۡجِبَالُ سَيۡرࣰا",true],[52,11,"فَوَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ",true]]},{"l":[[52,12,"ٱلَّذِينَ هُمۡ فِي خَوۡضࣲ يَلۡعَبُونَ",true],[52,13,"يَوۡمَ يُدَعُّونَ إِلَىٰ نَارِ",false]]},{"l":[[52,13,"جَهَنَّمَ دَعًّا",true],[52,14,"هَٰذِهِ ٱلنَّارُ ٱلَّتِي كُنتُم بِهَا تُكَذِّبُونَ",true]]}]}