{"p":568,"j":29,"rows":[{"l":[[69,36,"وَلَا طَعَامٌ إِلَّا مِنۡ غِسۡلِينࣲ",true],[69,37,"لَّا يَأۡكُلُهُۥٓ إِلَّا ٱلۡخَٰطِـُٔونَ",true],[69,38,"فَلَآ أُقۡسِمُ بِمَا",false]]},{"l":[[69,38,"تُبۡصِرُونَ",true],[69,39,"وَمَا لَا تُبۡصِرُونَ",true],[69,40,"إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِيمࣲ",true],[69,41,"وَمَا هُوَ بِقَوۡلِ",false]]},{"l":[[69,41,"شَاعِرࣲۚ قَلِيلࣰا مَّا تُؤۡمِنُونَ",true],[69,42,"وَلَا بِقَوۡلِ كَاهِنࣲۚ قَلِيلࣰا مَّا تَذَكَّرُونَ",true]]},{"l":[[69,43,"تَنزِيلࣱ مِّن رَّبِّ ٱلۡعَٰلَمِينَ",true],[69,44,"وَلَوۡ تَقَوَّلَ عَلَيۡنَا بَعۡضَ ٱلۡأَقَاوِيلِ",true]]},{"l":[[69,45,"لَأَخَذۡنَا مِنۡهُ بِٱلۡيَمِينِ",true],[69,46,"ثُمَّ لَقَطَعۡنَا مِنۡهُ ٱلۡوَتِينَ",true],[69,47,"فَمَا مِنكُم",false]]},{"l":[[69,47,"مِّنۡ أَحَدٍ عَنۡهُ حَٰجِزِينَ",true],[69,48,"وَإِنَّهُۥ لَتَذۡكِرَةࣱ لِّلۡمُتَّقِينَ",true],[69,49,"وَإِنَّا",false]]},{"l":[[69,49,"لَنَعۡلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ",true],[69,50,"وَإِنَّهُۥ لَحَسۡرَةٌ عَلَى ٱلۡكَٰفِرِينَ",true]]},{"l":[[69,51,"وَإِنَّهُۥ لَحَقُّ ٱلۡيَقِينِ",true],[69,52,"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ",true]]},{"h":70},{"b":1},{"l":[[70,1,"سَأَلَ سَآئِلُۢ بِعَذَابࣲ وَاقِعࣲ",true],[70,2,"لِّلۡكَٰفِرِينَ لَيۡسَ لَهُۥ دَافِعࣱ",true]]},{"l":[[70,3,"مِّنَ ٱللَّهِ ذِي ٱلۡمَعَارِجِ",true],[70,4,"تَعۡرُجُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيۡهِ فِي",false]]},{"l":[[70,4,"يَوۡمࣲ كَانَ مِقۡدَارُهُۥ خَمۡسِينَ أَلۡفَ سَنَةࣲ",true],[70,5,"فَٱصۡبِرۡ صَبۡرࣰا جَمِيلًا",true]]},{"l":[[70,6,"إِنَّهُمۡ يَرَوۡنَهُۥ بَعِيدࣰا",true],[70,7,"وَنَرَىٰهُ قَرِيبࣰا",true],[70,8,"يَوۡمَ تَكُونُ ٱلسَّمَآءُ",false]]},{"l":[[70,8,"كَٱلۡمُهۡلِ",true],[70,9,"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ",true],[70,10,"وَلَا يَسۡـَٔلُ حَمِيمٌ حَمِيمࣰا",true]]}]}