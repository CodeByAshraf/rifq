{"p":584,"j":30,"rows":[{"l":[[79,17,"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ",true],[79,18,"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",true]]},{"l":[[79,19,"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ",true],[79,20,"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ",true]]},{"l":[[79,21,"فَكَذَّبَ وَعَصَىٰ",true],[79,22,"ثُمَّ أَدۡبَرَ يَسۡعَىٰ",true],[79,23,"فَحَشَرَ فَنَادَىٰ",true]]},{"l":[[79,24,"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ",true],[79,25,"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ",true]]},{"l":[[79,26,"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةࣰ لِّمَن يَخۡشَىٰٓ",true],[79,27,"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ",false]]},{"l":[[79,27,"بَنَىٰهَا",true],[79,28,"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا",true],[79,29,"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ",false]]},{"l":[[79,29,"ضُحَىٰهَا",true],[79,30,"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ",true],[79,31,"أَخۡرَجَ مِنۡهَا مَآءَهَا",false]]},{"l":[[79,31,"وَمَرۡعَىٰهَا",true],[79,32,"وَٱلۡجِبَالَ أَرۡسَىٰهَا",true],[79,33,"مَتَٰعࣰا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ",true]]},{"l":[[79,34,"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ",true],[79,35,"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ",true]]},{"l":[[79,36,"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ",true],[79,37,"فَأَمَّا مَن طَغَىٰ",true],[79,38,"وَءَاثَرَ ٱلۡحَيَوٰةَ",false]]},{"l":[[79,38,"ٱلدُّنۡيَا",true],[79,39,"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ",true],[79,40,"وَأَمَّا مَنۡ خَافَ مَقَامَ",false]]},{"l":[[79,40,"رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ",true],[79,41,"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ",true]]},{"l":[[79,42,"يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا",true],[79,43,"فِيمَ أَنتَ مِن",false]]},{"l":[[79,43,"ذِكۡرَىٰهَآ",true],[79,44,"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ",true],[79,45,"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا",true]]},{"l":[[79,46,"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا",true]]}]}