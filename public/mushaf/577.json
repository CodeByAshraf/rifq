{"p":577,"j":29,"rows":[{"l":[[74,48,"فَمَا تَنفَعُهُمۡ شَفَٰعَةُ ٱلشَّٰفِعِينَ",true],[74,49,"فَمَا لَهُمۡ عَنِ ٱلتَّذۡكِرَةِ",false]]},{"l":[[74,49,"مُعۡرِضِينَ",true],[74,50,"كَأَنَّهُمۡ حُمُرࣱ مُّسۡتَنفِرَةࣱ",true],[74,51,"فَرَّتۡ مِن قَسۡوَرَةِۭ",true]]},{"l":[[74,52,"بَلۡ يُرِيدُ كُلُّ ٱمۡرِيࣲٕ مِّنۡهُمۡ أَن يُؤۡتَىٰ صُحُفࣰا مُّنَشَّرَةࣰ",true],[74,53,"كَلَّاۖ بَل لَّا",false]]},{"l":[[74,53,"يَخَافُونَ ٱلۡأٓخِرَةَ",true],[74,54,"كَلَّآ إِنَّهُۥ تَذۡكِرَةࣱ",true],[74,55,"فَمَن شَآءَ ذَكَرَهُۥ",true],[74,56,"وَمَا",false]]},{"l":[[74,56,"يَذۡكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهۡلُ ٱلتَّقۡوَىٰ وَأَهۡلُ ٱلۡمَغۡفِرَةِ",true]]},{"h":75},{"b":1},{"l":[[75,1,"لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ",true],[75,2,"وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ",true],[75,3,"أَيَحۡسَبُ",false]]},{"l":[[75,3,"ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ",true],[75,4,"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ",true],[75,5,"بَلۡ",false]]},{"l":[[75,5,"يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ",true],[75,6,"يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ",true],[75,7,"فَإِذَا بَرِقَ",false]]},{"l":[[75,7,"ٱلۡبَصَرُ",true],[75,8,"وَخَسَفَ ٱلۡقَمَرُ",true],[75,9,"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ",true],[75,10,"يَقُولُ ٱلۡإِنسَٰنُ",false]]},{"l":[[75,10,"يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ",true],[75,11,"كَلَّا لَا وَزَرَ",true],[75,12,"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ",true],[75,13,"يُنَبَّؤُاْ",false]]},{"l":[[75,13,"ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ",true],[75,14,"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةࣱ",true]]},{"l":[[75,15,"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ",true],[75,16,"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ",true],[75,17,"إِنَّ عَلَيۡنَا",false]]},{"l":[[75,17,"جَمۡعَهُۥ وَقُرۡءَانَهُۥ",true],[75,18,"فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ",true],[75,19,"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ",true]]}]}