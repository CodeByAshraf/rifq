{"p":375,"j":19,"rows":[{"l":[[26,184,"وَٱتَّقُواْ ٱلَّذِي خَلَقَكُمۡ وَٱلۡجِبِلَّةَ ٱلۡأَوَّلِينَ",true],[26,185,"قَالُوٓاْ إِنَّمَآ أَنتَ مِنَ",false]]},{"l":[[26,185,"ٱلۡمُسَحَّرِينَ",true],[26,186,"وَمَآ أَنتَ إِلَّا بَشَرࣱ مِّثۡلُنَا وَإِن نَّظُنُّكَ لَمِنَ",false]]},{"l":[[26,186,"ٱلۡكَٰذِبِينَ",true],[26,187,"فَأَسۡقِطۡ عَلَيۡنَا كِسَفࣰا مِّنَ ٱلسَّمَآءِ إِن كُنتَ",false]]},{"l":[[26,187,"مِنَ ٱلصَّٰدِقِينَ",true],[26,188,"قَالَ رَبِّيٓ أَعۡلَمُ بِمَا تَعۡمَلُونَ",true],[26,189,"فَكَذَّبُوهُ",false]]},{"l":[[26,189,"فَأَخَذَهُمۡ عَذَابُ يَوۡمِ ٱلظُّلَّةِۚ إِنَّهُۥ كَانَ عَذَابَ يَوۡمٍ عَظِيمٍ",true]]},{"l":[[26,190,"إِنَّ فِي ذَٰلِكَ لَأٓيَةࣰۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ",true],[26,191,"وَإِنَّ رَبَّكَ",false]]},{"l":[[26,191,"لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",true],[26,192,"وَإِنَّهُۥ لَتَنزِيلُ رَبِّ ٱلۡعَٰلَمِينَ",true],[26,193,"نَزَلَ بِهِ",false]]},{"l":[[26,193,"ٱلرُّوحُ ٱلۡأَمِينُ",true],[26,194,"عَلَىٰ قَلۡبِكَ لِتَكُونَ مِنَ ٱلۡمُنذِرِينَ",true],[26,195,"بِلِسَانٍ",false]]},{"l":[[26,195,"عَرَبِيࣲّ مُّبِينࣲ",true],[26,196,"وَإِنَّهُۥ لَفِي زُبُرِ ٱلۡأَوَّلِينَ",true],[26,197,"أَوَلَمۡ يَكُن لَّهُمۡ ءَايَةً",false]]},{"l":[[26,197,"أَن يَعۡلَمَهُۥ عُلَمَٰٓؤُاْ بَنِيٓ إِسۡرَٰٓءِيلَ",true],[26,198,"وَلَوۡ نَزَّلۡنَٰهُ عَلَىٰ بَعۡضِ",false]]},{"l":[[26,198,"ٱلۡأَعۡجَمِينَ",true],[26,199,"فَقَرَأَهُۥ عَلَيۡهِم مَّا كَانُواْ بِهِۦ مُؤۡمِنِينَ",true],[26,200,"كَذَٰلِكَ سَلَكۡنَٰهُ",false]]},{"l":[[26,200,"فِي قُلُوبِ ٱلۡمُجۡرِمِينَ",true],[26,201,"لَا يُؤۡمِنُونَ بِهِۦ حَتَّىٰ يَرَوُاْ ٱلۡعَذَابَ",false]]},{"l":[[26,201,"ٱلۡأَلِيمَ",true],[26,202,"فَيَأۡتِيَهُم بَغۡتَةࣰ وَهُمۡ لَا يَشۡعُرُونَ",true],[26,203,"فَيَقُولُواْ",false]]},{"l":[[26,203,"هَلۡ نَحۡنُ مُنظَرُونَ",true],[26,204,"أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ",true],[26,205,"أَفَرَءَيۡتَ",false]]},{"l":[[26,205,"إِن مَّتَّعۡنَٰهُمۡ سِنِينَ",true],[26,206,"ثُمَّ جَآءَهُم مَّا كَانُواْ يُوعَدُونَ",true]]}]}