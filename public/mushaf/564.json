{"p":564,"j":29,"rows":[{"l":[[67,27,"فَلَمَّا رَأَوۡهُ زُلۡفَةࣰ سِيٓـَٔتۡ وُجُوهُ ٱلَّذِينَ كَفَرُواْ وَقِيلَ هَٰذَا ٱلَّذِي كُنتُم",false]]},{"l":[[67,27,"بِهِۦ تَدَّعُونَ",true],[67,28,"قُلۡ أَرَءَيۡتُمۡ إِنۡ أَهۡلَكَنِيَ ٱللَّهُ وَمَن مَّعِيَ أَوۡ رَحِمَنَا",false]]},{"l":[[67,28,"فَمَن يُجِيرُ ٱلۡكَٰفِرِينَ مِنۡ عَذَابٍ أَلِيمࣲ",true],[67,29,"قُلۡ هُوَ ٱلرَّحۡمَٰنُ",false]]},{"l":[[67,29,"ءَامَنَّا بِهِۦ وَعَلَيۡهِ تَوَكَّلۡنَاۖ فَسَتَعۡلَمُونَ مَنۡ هُوَ فِي ضَلَٰلࣲ مُّبِينࣲ",true]]},{"l":[[67,30,"قُلۡ أَرَءَيۡتُمۡ إِنۡ أَصۡبَحَ مَآؤُكُمۡ غَوۡرࣰا فَمَن يَأۡتِيكُم بِمَآءࣲ مَّعِينِۭ",true]]},{"h":68},{"b":1},{"l":[[68,1,"نٓۚ وَٱلۡقَلَمِ وَمَا يَسۡطُرُونَ",true],[68,2,"مَآ أَنتَ بِنِعۡمَةِ رَبِّكَ بِمَجۡنُونࣲ",true],[68,3,"وَإِنَّ",false]]},{"l":[[68,3,"لَكَ لَأَجۡرًا غَيۡرَ مَمۡنُونࣲ",true],[68,4,"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمࣲ",true],[68,5,"فَسَتُبۡصِرُ",false]]},{"l":[[68,5,"وَيُبۡصِرُونَ",true],[68,6,"بِأَييِّكُمُ ٱلۡمَفۡتُونُ",true],[68,7,"إِنَّ رَبَّكَ هُوَ أَعۡلَمُ بِمَن ضَلَّ",false]]},{"l":[[68,7,"عَن سَبِيلِهِۦ وَهُوَ أَعۡلَمُ بِٱلۡمُهۡتَدِينَ",true],[68,8,"فَلَا تُطِعِ ٱلۡمُكَذِّبِينَ",true]]},{"l":[[68,9,"وَدُّواْ لَوۡ تُدۡهِنُ فَيُدۡهِنُونَ",true],[68,10,"وَلَا تُطِعۡ كُلَّ حَلَّافࣲ مَّهِينٍ",true]]},{"l":[[68,11,"هَمَّازࣲ مَّشَّآءِۭ بِنَمِيمࣲ",true],[68,12,"مَّنَّاعࣲ لِّلۡخَيۡرِ مُعۡتَدٍ أَثِيمٍ",true]]},{"l":[[68,13,"عُتُلِّۭ بَعۡدَ ذَٰلِكَ زَنِيمٍ",true],[68,14,"أَن كَانَ ذَا مَالࣲ وَبَنِينَ",true],[68,15,"إِذَا تُتۡلَىٰ عَلَيۡهِ",false]]},{"l":[[68,15,"ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ",true],[68,16,"سَنَسِمُهُۥ عَلَى ٱلۡخُرۡطُومِ",true]]}]}