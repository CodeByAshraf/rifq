{"p":452,"j":23,"rows":[{"l":[[37,154,"مَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ",true],[37,155,"أَفَلَا تَذَكَّرُونَ",true],[37,156,"أَمۡ لَكُمۡ سُلۡطَٰنࣱ",false]]},{"l":[[37,156,"مُّبِينࣱ",true],[37,157,"فَأۡتُواْ بِكِتَٰبِكُمۡ إِن كُنتُمۡ صَٰدِقِينَ",true],[37,158,"وَجَعَلُواْ بَيۡنَهُۥ",false]]},{"l":[[37,158,"وَبَيۡنَ ٱلۡجِنَّةِ نَسَبࣰاۚ وَلَقَدۡ عَلِمَتِ ٱلۡجِنَّةُ إِنَّهُمۡ لَمُحۡضَرُونَ",true]]},{"l":[[37,159,"سُبۡحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ",true],[37,160,"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ",true]]},{"l":[[37,161,"فَإِنَّكُمۡ وَمَا تَعۡبُدُونَ",true],[37,162,"مَآ أَنتُمۡ عَلَيۡهِ بِفَٰتِنِينَ",true]]},{"l":[[37,163,"إِلَّا مَنۡ هُوَ صَالِ ٱلۡجَحِيمِ",true],[37,164,"وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامࣱ مَّعۡلُومࣱ",true]]},{"l":[[37,165,"وَإِنَّا لَنَحۡنُ ٱلصَّآفُّونَ",true],[37,166,"وَإِنَّا لَنَحۡنُ ٱلۡمُسَبِّحُونَ",true]]},{"l":[[37,167,"وَإِن كَانُواْ لَيَقُولُونَ",true],[37,168,"لَوۡ أَنَّ عِندَنَا ذِكۡرࣰا مِّنَ ٱلۡأَوَّلِينَ",true]]},{"l":[[37,169,"لَكُنَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ",true],[37,170,"فَكَفَرُواْ بِهِۦۖ فَسَوۡفَ يَعۡلَمُونَ",true],[37,171,"وَلَقَدۡ",false]]},{"l":[[37,171,"سَبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا ٱلۡمُرۡسَلِينَ",true],[37,172,"إِنَّهُمۡ لَهُمُ ٱلۡمَنصُورُونَ",true]]},{"l":[[37,173,"وَإِنَّ جُندَنَا لَهُمُ ٱلۡغَٰلِبُونَ",true],[37,174,"فَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينࣲ",true],[37,175,"وَأَبۡصِرۡهُمۡ",false]]},{"l":[[37,175,"فَسَوۡفَ يُبۡصِرُونَ",true],[37,176,"أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ",true],[37,177,"فَإِذَا نَزَلَ بِسَاحَتِهِمۡ",false]]},{"l":[[37,177,"فَسَآءَ صَبَاحُ ٱلۡمُنذَرِينَ",true],[37,178,"وَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينࣲ",true],[37,179,"وَأَبۡصِرۡ",false]]},{"l":[[37,179,"فَسَوۡفَ يُبۡصِرُونَ",true],[37,180,"سُبۡحَٰنَ رَبِّكَ رَبِّ ٱلۡعِزَّةِ عَمَّا يَصِفُونَ",true]]},{"l":[[37,181,"وَسَلَٰمٌ عَلَى ٱلۡمُرۡسَلِينَ",true],[37,182,"وَٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ",true]]}]}