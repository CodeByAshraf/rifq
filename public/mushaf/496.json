{"p":496,"j":25,"rows":[{"h":44},{"b":1},{"l":[[44,1,"حمٓ",true],[44,2,"وَٱلۡكِتَٰبِ ٱلۡمُبِينِ",true],[44,3,"إِنَّآ أَنزَلۡنَٰهُ فِي لَيۡلَةࣲ مُّبَٰرَكَةٍۚ",false]]},{"l":[[44,3,"إِنَّا كُنَّا مُنذِرِينَ",true],[44,4,"فِيهَا يُفۡرَقُ كُلُّ أَمۡرٍ حَكِيمٍ",true],[44,5,"أَمۡرࣰا",false]]},{"l":[[44,5,"مِّنۡ عِندِنَآۚ إِنَّا كُنَّا مُرۡسِلِينَ",true],[44,6,"رَحۡمَةࣰ مِّن رَّبِّكَۚ إِنَّهُۥ هُوَ",false]]},{"l":[[44,6,"ٱلسَّمِيعُ ٱلۡعَلِيمُ",true],[44,7,"رَبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَآۖ",false]]},{"l":[[44,7,"إِن كُنتُم مُّوقِنِينَ",true],[44,8,"لَآ إِلَٰهَ إِلَّا هُوَ يُحۡيِۦ وَيُمِيتُۖ رَبُّكُمۡ",false]]},{"l":[[44,8,"وَرَبُّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ",true],[44,9,"بَلۡ هُمۡ فِي شَكࣲّ يَلۡعَبُونَ",true]]},{"l":[[44,10,"فَٱرۡتَقِبۡ يَوۡمَ تَأۡتِي ٱلسَّمَآءُ بِدُخَانࣲ مُّبِينࣲ",true],[44,11,"يَغۡشَى ٱلنَّاسَۖ",false]]},{"l":[[44,11,"هَٰذَا عَذَابٌ أَلِيمࣱ",true],[44,12,"رَّبَّنَا ٱكۡشِفۡ عَنَّا ٱلۡعَذَابَ إِنَّا مُؤۡمِنُونَ",true]]},{"l":[[44,13,"أَنَّىٰ لَهُمُ ٱلذِّكۡرَىٰ وَقَدۡ جَآءَهُمۡ رَسُولࣱ مُّبِينࣱ",true],[44,14,"ثُمَّ تَوَلَّوۡاْ",false]]},{"l":[[44,14,"عَنۡهُ وَقَالُواْ مُعَلَّمࣱ مَّجۡنُونٌ",true],[44,15,"إِنَّا كَاشِفُواْ ٱلۡعَذَابِ قَلِيلًاۚ إِنَّكُمۡ",false]]},{"l":[[44,15,"عَآئِدُونَ",true],[44,16,"يَوۡمَ نَبۡطِشُ ٱلۡبَطۡشَةَ ٱلۡكُبۡرَىٰٓ إِنَّا مُنتَقِمُونَ",true]]},{"l":[[44,17,"۞ وَلَقَدۡ فَتَنَّا قَبۡلَهُمۡ قَوۡمَ فِرۡعَوۡنَ وَجَآءَهُمۡ رَسُولࣱ كَرِيمٌ",true]]},{"l":[[44,18,"أَنۡ أَدُّوٓاْ إِلَيَّ عِبَادَ ٱللَّهِۖ إِنِّي لَكُمۡ رَسُولٌ أَمِينࣱ",true]]}]}