{"p":536,"j":27,"rows":[{"l":[[56,51,"ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ",true],[56,52,"لَأٓكِلُونَ مِن شَجَرࣲ مِّن زَقُّومࣲ",true]]},{"l":[[56,53,"فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ",true],[56,54,"فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ",true],[56,55,"فَشَٰرِبُونَ",false]]},{"l":[[56,55,"شُرۡبَ ٱلۡهِيمِ",true],[56,56,"هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ",true],[56,57,"نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا",false]]},{"l":[[56,57,"تُصَدِّقُونَ",true],[56,58,"أَفَرَءَيۡتُم مَّا تُمۡنُونَ",true],[56,59,"ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ",false]]},{"l":[[56,59,"ٱلۡخَٰلِقُونَ",true],[56,60,"نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ",true]]},{"l":[[56,61,"عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ",true],[56,62,"وَلَقَدۡ",false]]},{"l":[[56,62,"عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ",true],[56,63,"أَفَرَءَيۡتُم مَّا",false]]},{"l":[[56,63,"تَحۡرُثُونَ",true],[56,64,"ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّٰرِعُونَ",true],[56,65,"لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ",false]]},{"l":[[56,65,"حُطَٰمࣰا فَظَلۡتُمۡ تَفَكَّهُونَ",true],[56,66,"إِنَّا لَمُغۡرَمُونَ",true],[56,67,"بَلۡ نَحۡنُ",false]]},{"l":[[56,67,"مَحۡرُومُونَ",true],[56,68,"أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ",true],[56,69,"ءَأَنتُمۡ أَنزَلۡتُمُوهُ",false]]},{"l":[[56,69,"مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ",true],[56,70,"لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجࣰا فَلَوۡلَا",false]]},{"l":[[56,70,"تَشۡكُرُونَ",true],[56,71,"أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ",true],[56,72,"ءَأَنتُمۡ أَنشَأۡتُمۡ",false]]},{"l":[[56,72,"شَجَرَتَهَآ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ",true],[56,73,"نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةࣰ وَمَتَٰعࣰا",false]]},{"l":[[56,73,"لِّلۡمُقۡوِينَ",true],[56,74,"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ",true],[56,75,"۞ فَلَآ أُقۡسِمُ",false]]},{"l":[[56,75,"بِمَوَٰقِعِ ٱلنُّجُومِ",true],[56,76,"وَإِنَّهُۥ لَقَسَمࣱ لَّوۡ تَعۡلَمُونَ عَظِيمٌ",true]]}]}