{"p":537,"j":27,"rows":[{"l":[[56,77,"إِنَّهُۥ لَقُرۡءَانࣱ كَرِيمࣱ",true],[56,78,"فِي كِتَٰبࣲ مَّكۡنُونࣲ",true],[56,79,"لَّا يَمَسُّهُۥٓ إِلَّا",false]]},{"l":[[56,79,"ٱلۡمُطَهَّرُونَ",true],[56,80,"تَنزِيلࣱ مِّن رَّبِّ ٱلۡعَٰلَمِينَ",true],[56,81,"أَفَبِهَٰذَا ٱلۡحَدِيثِ",false]]},{"l":[[56,81,"أَنتُم مُّدۡهِنُونَ",true],[56,82,"وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ",true],[56,83,"فَلَوۡلَآ",false]]},{"l":[[56,83,"إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ",true],[56,84,"وَأَنتُمۡ حِينَئِذࣲ تَنظُرُونَ",true],[56,85,"وَنَحۡنُ أَقۡرَبُ",false]]},{"l":[[56,85,"إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ",true],[56,86,"فَلَوۡلَآ إِن كُنتُمۡ غَيۡرَ مَدِينِينَ",true]]},{"l":[[56,87,"تَرۡجِعُونَهَآ إِن كُنتُمۡ صَٰدِقِينَ",true],[56,88,"فَأَمَّآ إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ",true]]},{"l":[[56,89,"فَرَوۡحࣱ وَرَيۡحَانࣱ وَجَنَّتُ نَعِيمࣲ",true],[56,90,"وَأَمَّآ إِن كَانَ مِنۡ أَصۡحَٰبِ",false]]},{"l":[[56,90,"ٱلۡيَمِينِ",true],[56,91,"فَسَلَٰمࣱ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ",true],[56,92,"وَأَمَّآ إِن كَانَ مِنَ",false]]},{"l":[[56,92,"ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ",true],[56,93,"فَنُزُلࣱ مِّنۡ حَمِيمࣲ",true],[56,94,"وَتَصۡلِيَةُ جَحِيمٍ",true]]},{"l":[[56,95,"إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ",true],[56,96,"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ",true]]},{"h":57},{"b":1},{"l":[[57,1,"سَبَّحَ لِلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ",true],[57,2,"لَهُۥ مُلۡكُ",false]]},{"l":[[57,2,"ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ يُحۡيِۦ وَيُمِيتُۖ وَهُوَ عَلَىٰ كُلِّ شَيۡءࣲ قَدِيرٌ",true],[57,3,"هُوَ",false]]},{"l":[[57,3,"ٱلۡأَوَّلُ وَٱلۡأٓخِرُ وَٱلظَّٰهِرُ وَٱلۡبَاطِنُۖ وَهُوَ بِكُلِّ شَيۡءٍ عَلِيمٌ",true]]}]}