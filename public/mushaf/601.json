{"p":601,"j":30,"rows":[{"h":103},{"b":1},{"l":[[103,1,"وَٱلۡعَصۡرِ",true],[103,2,"إِنَّ ٱلۡإِنسَٰنَ لَفِي خُسۡرٍ",true],[103,3,"إِلَّا ٱلَّذِينَ ءَامَنُواْ",false]]},{"l":[[103,3,"وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَتَوَاصَوۡاْ بِٱلۡحَقِّ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ",true]]},{"h":104},{"b":1},{"l":[[104,1,"وَيۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ",true],[104,2,"ٱلَّذِي جَمَعَ مَالࣰا وَعَدَّدَهُۥ",true]]},{"l":[[104,3,"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ",true],[104,4,"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ",true]]},{"l":[[104,5,"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ",true],[104,6,"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ",true],[104,7,"ٱلَّتِي تَطَّلِعُ",false]]},{"l":[[104,7,"عَلَى ٱلۡأَفۡـِٔدَةِ",true],[104,8,"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةࣱ",true],[104,9,"فِي عَمَدࣲ مُّمَدَّدَةِۭ",true]]},{"h":105},{"b":1},{"l":[[105,1,"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ",true],[105,2,"أَلَمۡ يَجۡعَلۡ",false]]},{"l":[[105,2,"كَيۡدَهُمۡ فِي تَضۡلِيلࣲ",true],[105,3,"وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ",true]]},{"l":[[105,4,"تَرۡمِيهِم بِحِجَارَةࣲ مِّن سِجِّيلࣲ",true],[105,5,"فَجَعَلَهُمۡ كَعَصۡفࣲ مَّأۡكُولِۭ",true]]}]}