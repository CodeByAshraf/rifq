{"p":449,"j":23,"rows":[{"l":[[37,77,"وَجَعَلۡنَا ذُرِّيَّتَهُۥ هُمُ ٱلۡبَاقِينَ",true],[37,78,"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ",true],[37,79,"سَلَٰمٌ",false]]},{"l":[[37,79,"عَلَىٰ نُوحࣲ فِي ٱلۡعَٰلَمِينَ",true],[37,80,"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",true],[37,81,"إِنَّهُۥ",false]]},{"l":[[37,81,"مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ",true],[37,82,"ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ",true],[37,83,"۞ وَإِنَّ مِن",false]]},{"l":[[37,83,"شِيعَتِهِۦ لَإِبۡرَٰهِيمَ",true],[37,84,"إِذۡ جَآءَ رَبَّهُۥ بِقَلۡبࣲ سَلِيمٍ",true],[37,85,"إِذۡ قَالَ لِأَبِيهِ",false]]},{"l":[[37,85,"وَقَوۡمِهِۦ مَاذَا تَعۡبُدُونَ",true],[37,86,"أَئِفۡكًا ءَالِهَةࣰ دُونَ ٱللَّهِ تُرِيدُونَ",true]]},{"l":[[37,87,"فَمَا ظَنُّكُم بِرَبِّ ٱلۡعَٰلَمِينَ",true],[37,88,"فَنَظَرَ نَظۡرَةࣰ فِي ٱلنُّجُومِ",true]]},{"l":[[37,89,"فَقَالَ إِنِّي سَقِيمࣱ",true],[37,90,"فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ",true],[37,91,"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمۡ",false]]},{"l":[[37,91,"فَقَالَ أَلَا تَأۡكُلُونَ",true],[37,92,"مَا لَكُمۡ لَا تَنطِقُونَ",true],[37,93,"فَرَاغَ عَلَيۡهِمۡ ضَرۡبَۢا",false]]},{"l":[[37,93,"بِٱلۡيَمِينِ",true],[37,94,"فَأَقۡبَلُوٓاْ إِلَيۡهِ يَزِفُّونَ",true],[37,95,"قَالَ أَتَعۡبُدُونَ مَا تَنۡحِتُونَ",true]]},{"l":[[37,96,"وَٱللَّهُ خَلَقَكُمۡ وَمَا تَعۡمَلُونَ",true],[37,97,"قَالُواْ ٱبۡنُواْ لَهُۥ بُنۡيَٰنࣰا فَأَلۡقُوهُ",false]]},{"l":[[37,97,"فِي ٱلۡجَحِيمِ",true],[37,98,"فَأَرَادُواْ بِهِۦ كَيۡدࣰا فَجَعَلۡنَٰهُمُ ٱلۡأَسۡفَلِينَ",true]]},{"l":[[37,99,"وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهۡدِينِ",true],[37,100,"رَبِّ هَبۡ لِي مِنَ ٱلصَّٰلِحِينَ",true]]},{"l":[[37,101,"فَبَشَّرۡنَٰهُ بِغُلَٰمٍ حَلِيمࣲ",true],[37,102,"فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعۡيَ قَالَ يَٰبُنَيَّ",false]]},{"l":[[37,102,"إِنِّيٓ أَرَىٰ فِي ٱلۡمَنَامِ أَنِّيٓ أَذۡبَحُكَ فَٱنظُرۡ مَاذَا تَرَىٰۚ قَالَ يَٰٓأَبَتِ",false]]},{"l":[[37,102,"ٱفۡعَلۡ مَا تُؤۡمَرُۖ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰبِرِينَ",true]]}]}