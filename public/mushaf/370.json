{"p":370,"j":19,"rows":[{"l":[[26,61,"فَلَمَّا تَرَٰٓءَا ٱلۡجَمۡعَانِ قَالَ أَصۡحَٰبُ مُوسَىٰٓ إِنَّا لَمُدۡرَكُونَ",true]]},{"l":[[26,62,"قَالَ كَلَّآۖ إِنَّ مَعِيَ رَبِّي سَيَهۡدِينِ",true],[26,63,"فَأَوۡحَيۡنَآ إِلَىٰ مُوسَىٰٓ أَنِ",false]]},{"l":[[26,63,"ٱضۡرِب بِّعَصَاكَ ٱلۡبَحۡرَۖ فَٱنفَلَقَ فَكَانَ كُلُّ فِرۡقࣲ كَٱلطَّوۡدِ ٱلۡعَظِيمِ",true]]},{"l":[[26,64,"وَأَزۡلَفۡنَا ثَمَّ ٱلۡأٓخَرِينَ",true],[26,65,"وَأَنجَيۡنَا مُوسَىٰ وَمَن مَّعَهُۥٓ أَجۡمَعِينَ",true]]},{"l":[[26,66,"ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ",true],[26,67,"إِنَّ فِي ذَٰلِكَ لَأٓيَةࣰۖ وَمَا كَانَ",false]]},{"l":[[26,67,"أَكۡثَرُهُم مُّؤۡمِنِينَ",true],[26,68,"وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",true]]},{"l":[[26,69,"وَٱتۡلُ عَلَيۡهِمۡ نَبَأَ إِبۡرَٰهِيمَ",true],[26,70,"إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَا تَعۡبُدُونَ",true]]},{"l":[[26,71,"قَالُواْ نَعۡبُدُ أَصۡنَامࣰا فَنَظَلُّ لَهَا عَٰكِفِينَ",true],[26,72,"قَالَ هَلۡ",false]]},{"l":[[26,72,"يَسۡمَعُونَكُمۡ إِذۡ تَدۡعُونَ",true],[26,73,"أَوۡ يَنفَعُونَكُمۡ أَوۡ يَضُرُّونَ",true],[26,74,"قَالُواْ",false]]},{"l":[[26,74,"بَلۡ وَجَدۡنَآ ءَابَآءَنَا كَذَٰلِكَ يَفۡعَلُونَ",true],[26,75,"قَالَ أَفَرَءَيۡتُم مَّا كُنتُمۡ",false]]},{"l":[[26,75,"تَعۡبُدُونَ",true],[26,76,"أَنتُمۡ وَءَابَآؤُكُمُ ٱلۡأَقۡدَمُونَ",true],[26,77,"فَإِنَّهُمۡ عَدُوࣱّ لِّيٓ",false]]},{"l":[[26,77,"إِلَّا رَبَّ ٱلۡعَٰلَمِينَ",true],[26,78,"ٱلَّذِي خَلَقَنِي فَهُوَ يَهۡدِينِ",true],[26,79,"وَٱلَّذِي هُوَ",false]]},{"l":[[26,79,"يُطۡعِمُنِي وَيَسۡقِينِ",true],[26,80,"وَإِذَا مَرِضۡتُ فَهُوَ يَشۡفِينِ",true],[26,81,"وَٱلَّذِي",false]]},{"l":[[26,81,"يُمِيتُنِي ثُمَّ يُحۡيِينِ",true],[26,82,"وَٱلَّذِيٓ أَطۡمَعُ أَن يَغۡفِرَ لِي خَطِيٓـَٔتِي",false]]},{"l":[[26,82,"يَوۡمَ ٱلدِّينِ",true],[26,83,"رَبِّ هَبۡ لِي حُكۡمࣰا وَأَلۡحِقۡنِي بِٱلصَّٰلِحِينَ",true]]}]}