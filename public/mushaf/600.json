{"p":600,"j":30,"rows":[{"l":[[100,6,"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودࣱ",true],[100,7,"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدࣱ",true],[100,8,"وَإِنَّهُۥ لِحُبِّ",false]]},{"l":[[100,8,"ٱلۡخَيۡرِ لَشَدِيدٌ",true],[100,9,"۞ أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ",true]]},{"l":[[100,10,"وَحُصِّلَ مَا فِي ٱلصُّدُورِ",true],[100,11,"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذࣲ لَّخَبِيرُۢ",true]]},{"h":101},{"b":1},{"l":[[101,1,"ٱلۡقَارِعَةُ",true],[101,2,"مَا ٱلۡقَارِعَةُ",true],[101,3,"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ",true],[101,4,"يَوۡمَ",false]]},{"l":[[101,4,"يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ",true],[101,5,"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ",false]]},{"l":[[101,5,"ٱلۡمَنفُوشِ",true],[101,6,"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ",true],[101,7,"فَهُوَ فِي عِيشَةࣲ",false]]},{"l":[[101,7,"رَّاضِيَةࣲ",true],[101,8,"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ",true],[101,9,"فَأُمُّهُۥ هَاوِيَةࣱ",true]]},{"l":[[101,10,"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ",true],[101,11,"نَارٌ حَامِيَةُۢ",true]]},{"h":102},{"b":1},{"l":[[102,1,"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ",true],[102,2,"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ",true],[102,3,"كَلَّا سَوۡفَ تَعۡلَمُونَ",true],[102,4,"ثُمَّ",false]]},{"l":[[102,4,"كَلَّا سَوۡفَ تَعۡلَمُونَ",true],[102,5,"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ",true],[102,6,"لَتَرَوُنَّ ٱلۡجَحِيمَ",true]]},{"l":[[102,7,"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ",true],[102,8,"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ",true]]}]}