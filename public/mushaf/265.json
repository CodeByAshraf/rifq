{"p":265,"j":14,"rows":[{"l":[[15,52,"إِذۡ دَخَلُواْ عَلَيۡهِ فَقَالُواْ سَلَٰمࣰا قَالَ إِنَّا مِنكُمۡ وَجِلُونَ",true],[15,53,"قَالُواْ",false]]},{"l":[[15,53,"لَا تَوۡجَلۡ إِنَّا نُبَشِّرُكَ بِغُلَٰمٍ عَلِيمࣲ",true],[15,54,"قَالَ أَبَشَّرۡتُمُونِي عَلَىٰٓ أَن",false]]},{"l":[[15,54,"مَّسَّنِيَ ٱلۡكِبَرُ فَبِمَ تُبَشِّرُونَ",true],[15,55,"قَالُواْ بَشَّرۡنَٰكَ بِٱلۡحَقِّ",false]]},{"l":[[15,55,"فَلَا تَكُن مِّنَ ٱلۡقَٰنِطِينَ",true],[15,56,"قَالَ وَمَن يَقۡنَطُ مِن رَّحۡمَةِ",false]]},{"l":[[15,56,"رَبِّهِۦٓ إِلَّا ٱلضَّآلُّونَ",true],[15,57,"قَالَ فَمَا خَطۡبُكُمۡ أَيُّهَا ٱلۡمُرۡسَلُونَ",true]]},{"l":[[15,58,"قَالُوٓاْ إِنَّآ أُرۡسِلۡنَآ إِلَىٰ قَوۡمࣲ مُّجۡرِمِينَ",true],[15,59,"إِلَّآ ءَالَ لُوطٍ",false]]},{"l":[[15,59,"إِنَّا لَمُنَجُّوهُمۡ أَجۡمَعِينَ",true],[15,60,"إِلَّا ٱمۡرَأَتَهُۥ قَدَّرۡنَآ إِنَّهَا لَمِنَ",false]]},{"l":[[15,60,"ٱلۡغَٰبِرِينَ",true],[15,61,"فَلَمَّا جَآءَ ءَالَ لُوطٍ ٱلۡمُرۡسَلُونَ",true],[15,62,"قَالَ",false]]},{"l":[[15,62,"إِنَّكُمۡ قَوۡمࣱ مُّنكَرُونَ",true],[15,63,"قَالُواْ بَلۡ جِئۡنَٰكَ بِمَا كَانُواْ فِيهِ",false]]},{"l":[[15,63,"يَمۡتَرُونَ",true],[15,64,"وَأَتَيۡنَٰكَ بِٱلۡحَقِّ وَإِنَّا لَصَٰدِقُونَ",true],[15,65,"فَأَسۡرِ",false]]},{"l":[[15,65,"بِأَهۡلِكَ بِقِطۡعࣲ مِّنَ ٱلَّيۡلِ وَٱتَّبِعۡ أَدۡبَٰرَهُمۡ وَلَا يَلۡتَفِتۡ مِنكُمۡ أَحَدࣱ",false]]},{"l":[[15,65,"وَٱمۡضُواْ حَيۡثُ تُؤۡمَرُونَ",true],[15,66,"وَقَضَيۡنَآ إِلَيۡهِ ذَٰلِكَ ٱلۡأَمۡرَ أَنَّ",false]]},{"l":[[15,66,"دَابِرَ هَٰٓؤُلَآءِ مَقۡطُوعࣱ مُّصۡبِحِينَ",true],[15,67,"وَجَآءَ أَهۡلُ ٱلۡمَدِينَةِ",false]]},{"l":[[15,67,"يَسۡتَبۡشِرُونَ",true],[15,68,"قَالَ إِنَّ هَٰٓؤُلَآءِ ضَيۡفِي فَلَا تَفۡضَحُونِ",true]]},{"l":[[15,69,"وَٱتَّقُواْ ٱللَّهَ وَلَا تُخۡزُونِ",true],[15,70,"قَالُوٓاْ أَوَلَمۡ نَنۡهَكَ عَنِ ٱلۡعَٰلَمِينَ",true]]}]}