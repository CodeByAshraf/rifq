{"p":589,"j":30,"rows":[{"l":[[83,34,"فَٱلۡيَوۡمَ ٱلَّذِينَ ءَامَنُواْ مِنَ ٱلۡكُفَّارِ يَضۡحَكُونَ",true],[83,35,"عَلَى",false]]},{"l":[[83,35,"ٱلۡأَرَآئِكِ يَنظُرُونَ",true],[83,36,"هَلۡ ثُوِّبَ ٱلۡكُفَّارُ مَا كَانُواْ يَفۡعَلُونَ",true]]},{"h":84},{"b":1},{"l":[[84,1,"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ",true],[84,2,"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ",true],[84,3,"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ",true]]},{"l":[[84,4,"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ",true],[84,5,"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ",true],[84,6,"يَٰٓأَيُّهَا",false]]},{"l":[[84,6,"ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحࣰا فَمُلَٰقِيهِ",true],[84,7,"فَأَمَّا مَنۡ أُوتِيَ",false]]},{"l":[[84,7,"كِتَٰبَهُۥ بِيَمِينِهِۦ",true],[84,8,"فَسَوۡفَ يُحَاسَبُ حِسَابࣰا يَسِيرࣰا",true],[84,9,"وَيَنقَلِبُ",false]]},{"l":[[84,9,"إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورࣰا",true],[84,10,"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ",true],[84,11,"فَسَوۡفَ",false]]},{"l":[[84,11,"يَدۡعُواْ ثُبُورࣰا",true],[84,12,"وَيَصۡلَىٰ سَعِيرًا",true],[84,13,"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا",true]]},{"l":[[84,14,"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ",true],[84,15,"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرࣰا",true],[84,16,"فَلَآ أُقۡسِمُ",false]]},{"l":[[84,16,"بِٱلشَّفَقِ",true],[84,17,"وَٱلَّيۡلِ وَمَا وَسَقَ",true],[84,18,"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ",true]]},{"l":[[84,19,"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقࣲ",true],[84,20,"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ",true],[84,21,"وَإِذَا قُرِئَ",false]]},{"l":[[84,21,"عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩",true],[84,22,"بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ",true]]},{"l":[[84,23,"وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ",true],[84,24,"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ",true]]}]}