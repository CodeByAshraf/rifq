{"p":585,"j":30,"rows":[{"h":80},{"b":1},{"l":[[80,1,"عَبَسَ وَتَوَلَّىٰٓ",true],[80,2,"أَن جَآءَهُ ٱلۡأَعۡمَىٰ",true],[80,3,"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",true],[80,4,"أَوۡ يَذَّكَّرُ",false]]},{"l":[[80,4,"فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ",true],[80,5,"أَمَّا مَنِ ٱسۡتَغۡنَىٰ",true],[80,6,"فَأَنتَ لَهُۥ تَصَدَّىٰ",true],[80,7,"وَمَا عَلَيۡكَ",false]]},{"l":[[80,7,"أَلَّا يَزَّكَّىٰ",true],[80,8,"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ",true],[80,9,"وَهُوَ يَخۡشَىٰ",true],[80,10,"فَأَنتَ عَنۡهُ تَلَهَّىٰ",true]]},{"l":[[80,11,"كَلَّآ إِنَّهَا تَذۡكِرَةࣱ",true],[80,12,"فَمَن شَآءَ ذَكَرَهُۥ",true],[80,13,"فِي صُحُفࣲ مُّكَرَّمَةࣲ",true],[80,14,"مَّرۡفُوعَةࣲ",false]]},{"l":[[80,14,"مُّطَهَّرَةِۭ",true],[80,15,"بِأَيۡدِي سَفَرَةࣲ",true],[80,16,"كِرَامِۭ بَرَرَةࣲ",true],[80,17,"قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ",true],[80,18,"مِنۡ",false]]},{"l":[[80,18,"أَيِّ شَيۡءٍ خَلَقَهُۥ",true],[80,19,"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",true],[80,20,"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",true]]},{"l":[[80,21,"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ",true],[80,22,"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",true],[80,23,"كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ",true]]},{"l":[[80,24,"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ",true],[80,25,"أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبࣰّا",true],[80,26,"ثُمَّ شَقَقۡنَا",false]]},{"l":[[80,26,"ٱلۡأَرۡضَ شَقࣰّا",true],[80,27,"فَأَنۢبَتۡنَا فِيهَا حَبࣰّا",true],[80,28,"وَعِنَبࣰا وَقَضۡبࣰا",true],[80,29,"وَزَيۡتُونࣰا وَنَخۡلࣰا",true]]},{"l":[[80,30,"وَحَدَآئِقَ غُلۡبࣰا",true],[80,31,"وَفَٰكِهَةࣰ وَأَبࣰّا",true],[80,32,"مَّتَٰعࣰا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ",true],[80,33,"فَإِذَا جَآءَتِ",false]]},{"l":[[80,33,"ٱلصَّآخَّةُ",true],[80,34,"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ",true],[80,35,"وَأُمِّهِۦ وَأَبِيهِ",true],[80,36,"وَصَٰحِبَتِهِۦ",false]]},{"l":[[80,36,"وَبَنِيهِ",true],[80,37,"لِكُلِّ ٱمۡرِيࣲٕ مِّنۡهُمۡ يَوۡمَئِذࣲ شَأۡنࣱ يُغۡنِيهِ",true],[80,38,"وُجُوهࣱ يَوۡمَئِذࣲ",false]]},{"l":[[80,38,"مُّسۡفِرَةࣱ",true],[80,39,"ضَاحِكَةࣱ مُّسۡتَبۡشِرَةࣱ",true],[80,40,"وَوُجُوهࣱ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةࣱ",true]]}]}