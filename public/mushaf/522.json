{"p":522,"j":27,"rows":[{"l":[[51,31,"۞ قَالَ فَمَا خَطۡبُكُمۡ أَيُّهَا ٱلۡمُرۡسَلُونَ",true],[51,32,"قَالُوٓاْ إِنَّآ أُرۡسِلۡنَآ إِلَىٰ قَوۡمࣲ",false]]},{"l":[[51,32,"مُّجۡرِمِينَ",true],[51,33,"لِنُرۡسِلَ عَلَيۡهِمۡ حِجَارَةࣰ مِّن طِينࣲ",true],[51,34,"مُّسَوَّمَةً عِندَ رَبِّكَ",false]]},{"l":[[51,34,"لِلۡمُسۡرِفِينَ",true],[51,35,"فَأَخۡرَجۡنَا مَن كَانَ فِيهَا مِنَ ٱلۡمُؤۡمِنِينَ",true],[51,36,"فَمَا وَجَدۡنَا",false]]},{"l":[[51,36,"فِيهَا غَيۡرَ بَيۡتࣲ مِّنَ ٱلۡمُسۡلِمِينَ",true],[51,37,"وَتَرَكۡنَا فِيهَآ ءَايَةࣰ لِّلَّذِينَ يَخَافُونَ",false]]},{"l":[[51,37,"ٱلۡعَذَابَ ٱلۡأَلِيمَ",true],[51,38,"وَفِي مُوسَىٰٓ إِذۡ أَرۡسَلۡنَٰهُ إِلَىٰ فِرۡعَوۡنَ بِسُلۡطَٰنࣲ",false]]},{"l":[[51,38,"مُّبِينࣲ",true],[51,39,"فَتَوَلَّىٰ بِرُكۡنِهِۦ وَقَالَ سَٰحِرٌ أَوۡ مَجۡنُونࣱ",true],[51,40,"فَأَخَذۡنَٰهُ وَجُنُودَهُۥ",false]]},{"l":[[51,40,"فَنَبَذۡنَٰهُمۡ فِي ٱلۡيَمِّ وَهُوَ مُلِيمࣱ",true],[51,41,"وَفِي عَادٍ إِذۡ أَرۡسَلۡنَا عَلَيۡهِمُ ٱلرِّيحَ",false]]},{"l":[[51,41,"ٱلۡعَقِيمَ",true],[51,42,"مَا تَذَرُ مِن شَيۡءٍ أَتَتۡ عَلَيۡهِ إِلَّا جَعَلَتۡهُ كَٱلرَّمِيمِ",true]]},{"l":[[51,43,"وَفِي ثَمُودَ إِذۡ قِيلَ لَهُمۡ تَمَتَّعُواْ حَتَّىٰ حِينࣲ",true],[51,44,"فَعَتَوۡاْ عَنۡ أَمۡرِ رَبِّهِمۡ",false]]},{"l":[[51,44,"فَأَخَذَتۡهُمُ ٱلصَّٰعِقَةُ وَهُمۡ يَنظُرُونَ",true],[51,45,"فَمَا ٱسۡتَطَٰعُواْ مِن قِيَامࣲ",false]]},{"l":[[51,45,"وَمَا كَانُواْ مُنتَصِرِينَ",true],[51,46,"وَقَوۡمَ نُوحࣲ مِّن قَبۡلُۖ إِنَّهُمۡ كَانُواْ قَوۡمࣰا",false]]},{"l":[[51,46,"فَٰسِقِينَ",true],[51,47,"وَٱلسَّمَآءَ بَنَيۡنَٰهَا بِأَيۡيْدࣲ وَإِنَّا لَمُوسِعُونَ",true],[51,48,"وَٱلۡأَرۡضَ",false]]},{"l":[[51,48,"فَرَشۡنَٰهَا فَنِعۡمَ ٱلۡمَٰهِدُونَ",true],[51,49,"وَمِن كُلِّ شَيۡءٍ خَلَقۡنَا زَوۡجَيۡنِ",false]]},{"l":[[51,49,"لَعَلَّكُمۡ تَذَكَّرُونَ",true],[51,50,"فَفِرُّوٓاْ إِلَى ٱللَّهِۖ إِنِّي لَكُم مِّنۡهُ نَذِيرࣱ مُّبِينࣱ",true]]},{"l":[[51,51,"وَلَا تَجۡعَلُواْ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَۖ إِنِّي لَكُم مِّنۡهُ نَذِيرࣱ مُّبِينࣱ",true]]}]}