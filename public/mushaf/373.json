{"p":373,"j":19,"rows":[{"l":[[26,137,"إِنۡ هَٰذَآ إِلَّا خُلُقُ ٱلۡأَوَّلِينَ",true],[26,138,"وَمَا نَحۡنُ بِمُعَذَّبِينَ",true],[26,139,"فَكَذَّبُوهُ",false]]},{"l":[[26,139,"فَأَهۡلَكۡنَٰهُمۡۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةࣰۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ",true]]},{"l":[[26,140,"وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",true],[26,141,"كَذَّبَتۡ ثَمُودُ ٱلۡمُرۡسَلِينَ",true],[26,142,"إِذۡ",false]]},{"l":[[26,142,"قَالَ لَهُمۡ أَخُوهُمۡ صَٰلِحٌ أَلَا تَتَّقُونَ",true],[26,143,"إِنِّي لَكُمۡ رَسُولٌ أَمِينࣱ",true]]},{"l":[[26,144,"فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ",true],[26,145,"وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ",false]]},{"l":[[26,145,"إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ",true],[26,146,"أَتُتۡرَكُونَ فِي مَا هَٰهُنَآ ءَامِنِينَ",true]]},{"l":[[26,147,"فِي جَنَّٰتࣲ وَعُيُونࣲ",true],[26,148,"وَزُرُوعࣲ وَنَخۡلࣲ طَلۡعُهَا هَضِيمࣱ",true]]},{"l":[[26,149,"وَتَنۡحِتُونَ مِنَ ٱلۡجِبَالِ بُيُوتࣰا فَٰرِهِينَ",true],[26,150,"فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ",true]]},{"l":[[26,151,"وَلَا تُطِيعُوٓاْ أَمۡرَ ٱلۡمُسۡرِفِينَ",true],[26,152,"ٱلَّذِينَ يُفۡسِدُونَ فِي ٱلۡأَرۡضِ",false]]},{"l":[[26,152,"وَلَا يُصۡلِحُونَ",true],[26,153,"قَالُوٓاْ إِنَّمَآ أَنتَ مِنَ ٱلۡمُسَحَّرِينَ",true],[26,154,"مَآ أَنتَ",false]]},{"l":[[26,154,"إِلَّا بَشَرࣱ مِّثۡلُنَا فَأۡتِ بِـَٔايَةٍ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ",true],[26,155,"قَالَ",false]]},{"l":[[26,155,"هَٰذِهِۦ نَاقَةࣱ لَّهَا شِرۡبࣱ وَلَكُمۡ شِرۡبُ يَوۡمࣲ مَّعۡلُومࣲ",true],[26,156,"وَلَا تَمَسُّوهَا",false]]},{"l":[[26,156,"بِسُوٓءࣲ فَيَأۡخُذَكُمۡ عَذَابُ يَوۡمٍ عَظِيمࣲ",true],[26,157,"فَعَقَرُوهَا فَأَصۡبَحُواْ",false]]},{"l":[[26,157,"نَٰدِمِينَ",true],[26,158,"فَأَخَذَهُمُ ٱلۡعَذَابُۚ إِنَّ فِي ذَٰلِكَ لَأٓيَةࣰۖ وَمَا كَانَ",false]]},{"l":[[26,158,"أَكۡثَرُهُم مُّؤۡمِنِينَ",true],[26,159,"وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",true]]}]}