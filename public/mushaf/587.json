{"p":587,"j":30,"rows":[{"h":82},{"b":1},{"l":[[82,1,"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ",true],[82,2,"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ",true],[82,3,"وَإِذَا ٱلۡبِحَارُ",false]]},{"l":[[82,3,"فُجِّرَتۡ",true],[82,4,"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ",true],[82,5,"عَلِمَتۡ نَفۡسࣱ مَّا قَدَّمَتۡ",false]]},{"l":[[82,5,"وَأَخَّرَتۡ",true],[82,6,"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ",true],[82,7,"ٱلَّذِي",false]]},{"l":[[82,7,"خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",true],[82,8,"فِيٓ أَيِّ صُورَةࣲ مَّا شَآءَ رَكَّبَكَ",true]]},{"l":[[82,9,"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ",true],[82,10,"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ",true],[82,11,"كِرَامࣰا",false]]},{"l":[[82,11,"كَٰتِبِينَ",true],[82,12,"يَعۡلَمُونَ مَا تَفۡعَلُونَ",true],[82,13,"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمࣲ",true],[82,14,"وَإِنَّ",false]]},{"l":[[82,14,"ٱلۡفُجَّارَ لَفِي جَحِيمࣲ",true],[82,15,"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ",true],[82,16,"وَمَا هُمۡ عَنۡهَا",false]]},{"l":[[82,16,"بِغَآئِبِينَ",true],[82,17,"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ",true],[82,18,"ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ",false]]},{"l":[[82,18,"ٱلدِّينِ",true],[82,19,"يَوۡمَ لَا تَمۡلِكُ نَفۡسࣱ لِّنَفۡسࣲ شَيۡـࣰٔاۖ وَٱلۡأَمۡرُ يَوۡمَئِذࣲ لِّلَّهِ",true]]},{"h":83},{"b":1},{"l":[[83,1,"وَيۡلࣱ لِّلۡمُطَفِّفِينَ",true],[83,2,"ٱلَّذِينَ إِذَا ٱكۡتَالُواْ عَلَى ٱلنَّاسِ يَسۡتَوۡفُونَ",true]]},{"l":[[83,3,"وَإِذَا كَالُوهُمۡ أَو وَّزَنُوهُمۡ يُخۡسِرُونَ",true],[83,4,"أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُم مَّبۡعُوثُونَ",true]]}]}