{"p":597,"j":30,"rows":[{"l":[[94,3,"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ",true],[94,4,"وَرَفَعۡنَا لَكَ ذِكۡرَكَ",true],[94,5,"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا",true]]},{"l":[[94,6,"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرࣰا",true],[94,7,"فَإِذَا فَرَغۡتَ فَٱنصَبۡ",true],[94,8,"وَإِلَىٰ رَبِّكَ فَٱرۡغَب",true]]},{"h":95},{"b":1},{"l":[[95,1,"وَٱلتِّينِ وَٱلزَّيۡتُونِ",true],[95,2,"وَطُورِ سِينِينَ",true],[95,3,"وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ",true]]},{"l":[[95,4,"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمࣲ",true],[95,5,"ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ",true]]},{"l":[[95,6,"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونࣲ",true]]},{"l":[[95,7,"فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ",true],[95,8,"أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ",true]]},{"h":96},{"b":1},{"l":[[96,1,"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ",true],[96,2,"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ",true],[96,3,"ٱقۡرَأۡ",false]]},{"l":[[96,3,"وَرَبُّكَ ٱلۡأَكۡرَمُ",true],[96,4,"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ",true],[96,5,"عَلَّمَ ٱلۡإِنسَٰنَ",false]]},{"l":[[96,5,"مَا لَمۡ يَعۡلَمۡ",true],[96,6,"كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ",true],[96,7,"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ",true]]},{"l":[[96,8,"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ",true],[96,9,"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ",true],[96,10,"عَبۡدًا",false]]},{"l":[[96,10,"إِذَا صَلَّىٰٓ",true],[96,11,"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ",true],[96,12,"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ",true]]}]}