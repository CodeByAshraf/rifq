{"p":593,"j":30,"rows":[{"l":[[88,23,"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",true],[88,24,"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ",true]]},{"l":[[88,25,"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ",true],[88,26,"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم",true]]},{"h":89},{"b":1},{"l":[[89,1,"وَٱلۡفَجۡرِ",true],[89,2,"وَلَيَالٍ عَشۡرࣲ",true],[89,3,"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ",true],[89,4,"وَٱلَّيۡلِ إِذَا يَسۡرِ",true]]},{"l":[[89,5,"هَلۡ فِي ذَٰلِكَ قَسَمࣱ لِّذِي حِجۡرٍ",true],[89,6,"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ",true]]},{"l":[[89,7,"إِرَمَ ذَاتِ ٱلۡعِمَادِ",true],[89,8,"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ",true],[89,9,"وَثَمُودَ ٱلَّذِينَ",false]]},{"l":[[89,9,"جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ",true],[89,10,"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ",true],[89,11,"ٱلَّذِينَ طَغَوۡاْ فِي",false]]},{"l":[[89,11,"ٱلۡبِلَٰدِ",true],[89,12,"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ",true],[89,13,"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ",false]]},{"l":[[89,13,"عَذَابٍ",true],[89,14,"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ",true],[89,15,"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ",false]]},{"l":[[89,15,"رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ",true],[89,16,"وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ",false]]},{"l":[[89,16,"فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ",true],[89,17,"كَلَّاۖ بَل لَّا تُكۡرِمُونَ",false]]},{"l":[[89,17,"ٱلۡيَتِيمَ",true],[89,18,"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ",true],[89,19,"وَتَأۡكُلُونَ",false]]},{"l":[[89,19,"ٱلتُّرَاثَ أَكۡلࣰا لَّمࣰّا",true],[89,20,"وَتُحِبُّونَ ٱلۡمَالَ حُبࣰّا جَمࣰّا",true],[89,21,"كَلَّآۖ إِذَا",false]]},{"l":[[89,21,"دُكَّتِ ٱلۡأَرۡضُ دَكࣰّا دَكࣰّا",true],[89,22,"وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفࣰّا صَفࣰّا",true]]}]}