{"p":586,"j":30,"rows":[{"l":[[80,41,"تَرۡهَقُهَا قَتَرَةٌ",true],[80,42,"أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ",true]]},{"h":81},{"b":1},{"l":[[81,1,"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ",true],[81,2,"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ",true],[81,3,"وَإِذَا ٱلۡجِبَالُ",false]]},{"l":[[81,3,"سُيِّرَتۡ",true],[81,4,"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ",true],[81,5,"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ",true]]},{"l":[[81,6,"وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ",true],[81,7,"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ",true],[81,8,"وَإِذَا ٱلۡمَوۡءُۥدَةُ",false]]},{"l":[[81,8,"سُئِلَتۡ",true],[81,9,"بِأَيِّ ذَنۢبࣲ قُتِلَتۡ",true],[81,10,"وَإِذَا ٱلصُّحُفُ نُشِرَتۡ",true]]},{"l":[[81,11,"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ",true],[81,12,"وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ",true],[81,13,"وَإِذَا ٱلۡجَنَّةُ",false]]},{"l":[[81,13,"أُزۡلِفَتۡ",true],[81,14,"عَلِمَتۡ نَفۡسࣱ مَّآ أَحۡضَرَتۡ",true],[81,15,"فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ",true]]},{"l":[[81,16,"ٱلۡجَوَارِ ٱلۡكُنَّسِ",true],[81,17,"وَٱلَّيۡلِ إِذَا عَسۡعَسَ",true],[81,18,"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ",true]]},{"l":[[81,19,"إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِيمࣲ",true],[81,20,"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينࣲ",true],[81,21,"مُّطَاعࣲ ثَمَّ",false]]},{"l":[[81,21,"أَمِينࣲ",true],[81,22,"وَمَا صَاحِبُكُم بِمَجۡنُونࣲ",true],[81,23,"وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ",true]]},{"l":[[81,24,"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينࣲ",true],[81,25,"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنࣲ رَّجِيمࣲ",true]]},{"l":[[81,26,"فَأَيۡنَ تَذۡهَبُونَ",true],[81,27,"إِنۡ هُوَ إِلَّا ذِكۡرࣱ لِّلۡعَٰلَمِينَ",true],[81,28,"لِمَن شَآءَ مِنكُمۡ أَن",false]]},{"l":[[81,28,"يَسۡتَقِيمَ",true],[81,29,"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ",true]]}]}