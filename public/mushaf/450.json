{"p":450,"j":23,"rows":[{"l":[[37,103,"فَلَمَّآ أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِينِ",true],[37,104,"وَنَٰدَيۡنَٰهُ أَن يَٰٓإِبۡرَٰهِيمُ",true]]},{"l":[[37,105,"قَدۡ صَدَّقۡتَ ٱلرُّءۡيَآۚ إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",true],[37,106,"إِنَّ",false]]},{"l":[[37,106,"هَٰذَا لَهُوَ ٱلۡبَلَٰٓؤُاْ ٱلۡمُبِينُ",true],[37,107,"وَفَدَيۡنَٰهُ بِذِبۡحٍ عَظِيمࣲ",true],[37,108,"وَتَرَكۡنَا",false]]},{"l":[[37,108,"عَلَيۡهِ فِي ٱلۡأٓخِرِينَ",true],[37,109,"سَلَٰمٌ عَلَىٰٓ إِبۡرَٰهِيمَ",true],[37,110,"كَذَٰلِكَ نَجۡزِي",false]]},{"l":[[37,110,"ٱلۡمُحۡسِنِينَ",true],[37,111,"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ",true],[37,112,"وَبَشَّرۡنَٰهُ",false]]},{"l":[[37,112,"بِإِسۡحَٰقَ نَبِيࣰّا مِّنَ ٱلصَّٰلِحِينَ",true],[37,113,"وَبَٰرَكۡنَا عَلَيۡهِ وَعَلَىٰٓ إِسۡحَٰقَۚ",false]]},{"l":[[37,113,"وَمِن ذُرِّيَّتِهِمَا مُحۡسِنࣱ وَظَالِمࣱ لِّنَفۡسِهِۦ مُبِينࣱ",true],[37,114,"وَلَقَدۡ مَنَنَّا",false]]},{"l":[[37,114,"عَلَىٰ مُوسَىٰ وَهَٰرُونَ",true],[37,115,"وَنَجَّيۡنَٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ",false]]},{"l":[[37,115,"ٱلۡعَظِيمِ",true],[37,116,"وَنَصَرۡنَٰهُمۡ فَكَانُواْ هُمُ ٱلۡغَٰلِبِينَ",true],[37,117,"وَءَاتَيۡنَٰهُمَا",false]]},{"l":[[37,117,"ٱلۡكِتَٰبَ ٱلۡمُسۡتَبِينَ",true],[37,118,"وَهَدَيۡنَٰهُمَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ",true]]},{"l":[[37,119,"وَتَرَكۡنَا عَلَيۡهِمَا فِي ٱلۡأٓخِرِينَ",true],[37,120,"سَلَٰمٌ عَلَىٰ مُوسَىٰ",false]]},{"l":[[37,120,"وَهَٰرُونَ",true],[37,121,"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ",true],[37,122,"إِنَّهُمَا",false]]},{"l":[[37,122,"مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ",true],[37,123,"وَإِنَّ إِلۡيَاسَ لَمِنَ ٱلۡمُرۡسَلِينَ",true]]},{"l":[[37,124,"إِذۡ قَالَ لِقَوۡمِهِۦٓ أَلَا تَتَّقُونَ",true],[37,125,"أَتَدۡعُونَ بَعۡلࣰا وَتَذَرُونَ أَحۡسَنَ",false]]},{"l":[[37,125,"ٱلۡخَٰلِقِينَ",true],[37,126,"ٱللَّهَ رَبَّكُمۡ وَرَبَّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ",true]]}]}