{"p":448,"j":23,"rows":[{"l":[[37,52,"يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ",true],[37,53,"أَءِذَا مِتۡنَا وَكُنَّا تُرَابࣰا وَعِظَٰمًا أَءِنَّا",false]]},{"l":[[37,53,"لَمَدِينُونَ",true],[37,54,"قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ",true],[37,55,"فَٱطَّلَعَ فَرَءَاهُ فِي سَوَآءِ",false]]},{"l":[[37,55,"ٱلۡجَحِيمِ",true],[37,56,"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ",true],[37,57,"وَلَوۡلَا نِعۡمَةُ رَبِّي",false]]},{"l":[[37,57,"لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ",true],[37,58,"أَفَمَا نَحۡنُ بِمَيِّتِينَ",true],[37,59,"إِلَّا مَوۡتَتَنَا",false]]},{"l":[[37,59,"ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ",true],[37,60,"إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ",true]]},{"l":[[37,61,"لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ",true],[37,62,"أَذَٰلِكَ خَيۡرࣱ نُّزُلًا أَمۡ شَجَرَةُ",false]]},{"l":[[37,62,"ٱلزَّقُّومِ",true],[37,63,"إِنَّا جَعَلۡنَٰهَا فِتۡنَةࣰ لِّلظَّٰلِمِينَ",true],[37,64,"إِنَّهَا شَجَرَةࣱ تَخۡرُجُ",false]]},{"l":[[37,64,"فِيٓ أَصۡلِ ٱلۡجَحِيمِ",true],[37,65,"طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ",true]]},{"l":[[37,66,"فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ",true],[37,67,"ثُمَّ إِنَّ لَهُمۡ",false]]},{"l":[[37,67,"عَلَيۡهَا لَشَوۡبࣰا مِّنۡ حَمِيمࣲ",true],[37,68,"ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ",true]]},{"l":[[37,69,"إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ",true],[37,70,"فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ",true]]},{"l":[[37,71,"وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِينَ",true],[37,72,"وَلَقَدۡ أَرۡسَلۡنَا فِيهِم",false]]},{"l":[[37,72,"مُّنذِرِينَ",true],[37,73,"فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ",true]]},{"l":[[37,74,"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ",true],[37,75,"وَلَقَدۡ نَادَىٰنَا نُوحࣱ فَلَنِعۡمَ",false]]},{"l":[[37,75,"ٱلۡمُجِيبُونَ",true],[37,76,"وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ",true]]}]}