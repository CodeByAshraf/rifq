{"p":266,"j":14,"rows":[{"l":[[15,71,"قَالَ هَٰٓؤُلَآءِ بَنَاتِيٓ إِن كُنتُمۡ فَٰعِلِينَ",true],[15,72,"لَعَمۡرُكَ إِنَّهُمۡ لَفِي سَكۡرَتِهِمۡ",false]]},{"l":[[15,72,"يَعۡمَهُونَ",true],[15,73,"فَأَخَذَتۡهُمُ ٱلصَّيۡحَةُ مُشۡرِقِينَ",true],[15,74,"فَجَعَلۡنَا عَٰلِيَهَا",false]]},{"l":[[15,74,"سَافِلَهَا وَأَمۡطَرۡنَا عَلَيۡهِمۡ حِجَارَةࣰ مِّن سِجِّيلٍ",true],[15,75,"إِنَّ فِي ذَٰلِكَ",false]]},{"l":[[15,75,"لَأٓيَٰتࣲ لِّلۡمُتَوَسِّمِينَ",true],[15,76,"وَإِنَّهَا لَبِسَبِيلࣲ مُّقِيمٍ",true],[15,77,"إِنَّ فِي ذَٰلِكَ",false]]},{"l":[[15,77,"لَأٓيَةࣰ لِّلۡمُؤۡمِنِينَ",true],[15,78,"وَإِن كَانَ أَصۡحَٰبُ ٱلۡأَيۡكَةِ لَظَٰلِمِينَ",true]]},{"l":[[15,79,"فَٱنتَقَمۡنَا مِنۡهُمۡ وَإِنَّهُمَا لَبِإِمَامࣲ مُّبِينࣲ",true],[15,80,"وَلَقَدۡ كَذَّبَ أَصۡحَٰبُ",false]]},{"l":[[15,80,"ٱلۡحِجۡرِ ٱلۡمُرۡسَلِينَ",true],[15,81,"وَءَاتَيۡنَٰهُمۡ ءَايَٰتِنَا فَكَانُواْ عَنۡهَا مُعۡرِضِينَ",true]]},{"l":[[15,82,"وَكَانُواْ يَنۡحِتُونَ مِنَ ٱلۡجِبَالِ بُيُوتًا ءَامِنِينَ",true],[15,83,"فَأَخَذَتۡهُمُ",false]]},{"l":[[15,83,"ٱلصَّيۡحَةُ مُصۡبِحِينَ",true],[15,84,"فَمَآ أَغۡنَىٰ عَنۡهُم مَّا كَانُواْ يَكۡسِبُونَ",true]]},{"l":[[15,85,"وَمَا خَلَقۡنَا ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَ وَمَا بَيۡنَهُمَآ إِلَّا بِٱلۡحَقِّۗ وَإِنَّ",false]]},{"l":[[15,85,"ٱلسَّاعَةَ لَأٓتِيَةࣱۖ فَٱصۡفَحِ ٱلصَّفۡحَ ٱلۡجَمِيلَ",true],[15,86,"إِنَّ رَبَّكَ هُوَ",false]]},{"l":[[15,86,"ٱلۡخَلَّٰقُ ٱلۡعَلِيمُ",true],[15,87,"وَلَقَدۡ ءَاتَيۡنَٰكَ سَبۡعࣰا مِّنَ ٱلۡمَثَانِي",false]]},{"l":[[15,87,"وَٱلۡقُرۡءَانَ ٱلۡعَظِيمَ",true],[15,88,"لَا تَمُدَّنَّ عَيۡنَيۡكَ إِلَىٰ مَا مَتَّعۡنَا بِهِۦٓ أَزۡوَٰجࣰا",false]]},{"l":[[15,88,"مِّنۡهُمۡ وَلَا تَحۡزَنۡ عَلَيۡهِمۡ وَٱخۡفِضۡ جَنَاحَكَ لِلۡمُؤۡمِنِينَ",true],[15,89,"وَقُلۡ",false]]},{"l":[[15,89,"إِنِّيٓ أَنَا ٱلنَّذِيرُ ٱلۡمُبِينُ",true],[15,90,"كَمَآ أَنزَلۡنَا عَلَى ٱلۡمُقۡتَسِمِينَ",true]]}]}