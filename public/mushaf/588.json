{"p":588,"j":30,"rows":[{"l":[[83,5,"لِيَوۡمٍ عَظِيمࣲ",true],[83,6,"يَوۡمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلۡعَٰلَمِينَ",true],[83,7,"كَلَّآ إِنَّ كِتَٰبَ",false]]},{"l":[[83,7,"ٱلۡفُجَّارِ لَفِي سِجِّينࣲ",true],[83,8,"وَمَآ أَدۡرَىٰكَ مَا سِجِّينࣱ",true],[83,9,"كِتَٰبࣱ مَّرۡقُومࣱ",true]]},{"l":[[83,10,"وَيۡلࣱ يَوۡمَئِذࣲ لِّلۡمُكَذِّبِينَ",true],[83,11,"ٱلَّذِينَ يُكَذِّبُونَ بِيَوۡمِ ٱلدِّينِ",true],[83,12,"وَمَا يُكَذِّبُ",false]]},{"l":[[83,12,"بِهِۦٓ إِلَّا كُلُّ مُعۡتَدٍ أَثِيمٍ",true],[83,13,"إِذَا تُتۡلَىٰ عَلَيۡهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلۡأَوَّلِينَ",true]]},{"l":[[83,14,"كَلَّاۖ بَلۡۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكۡسِبُونَ",true],[83,15,"كَلَّآ إِنَّهُمۡ عَن رَّبِّهِمۡ",false]]},{"l":[[83,15,"يَوۡمَئِذࣲ لَّمَحۡجُوبُونَ",true],[83,16,"ثُمَّ إِنَّهُمۡ لَصَالُواْ ٱلۡجَحِيمِ",true],[83,17,"ثُمَّ يُقَالُ هَٰذَا",false]]},{"l":[[83,17,"ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ",true],[83,18,"كَلَّآ إِنَّ كِتَٰبَ ٱلۡأَبۡرَارِ لَفِي عِلِّيِّينَ",true]]},{"l":[[83,19,"وَمَآ أَدۡرَىٰكَ مَا عِلِّيُّونَ",true],[83,20,"كِتَٰبࣱ مَّرۡقُومࣱ",true],[83,21,"يَشۡهَدُهُ ٱلۡمُقَرَّبُونَ",true]]},{"l":[[83,22,"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٍ",true],[83,23,"عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ",true],[83,24,"تَعۡرِفُ فِي",false]]},{"l":[[83,24,"وُجُوهِهِمۡ نَضۡرَةَ ٱلنَّعِيمِ",true],[83,25,"يُسۡقَوۡنَ مِن رَّحِيقࣲ مَّخۡتُومٍ",true],[83,26,"خِتَٰمُهُۥ",false]]},{"l":[[83,26,"مِسۡكࣱۚ وَفِي ذَٰلِكَ فَلۡيَتَنَافَسِ ٱلۡمُتَنَٰفِسُونَ",true],[83,27,"وَمِزَاجُهُۥ مِن",false]]},{"l":[[83,27,"تَسۡنِيمٍ",true],[83,28,"عَيۡنࣰا يَشۡرَبُ بِهَا ٱلۡمُقَرَّبُونَ",true],[83,29,"إِنَّ ٱلَّذِينَ أَجۡرَمُواْ كَانُواْ",false]]},{"l":[[83,29,"مِنَ ٱلَّذِينَ ءَامَنُواْ يَضۡحَكُونَ",true],[83,30,"وَإِذَا مَرُّواْ بِهِمۡ يَتَغَامَزُونَ",true]]},{"l":[[83,31,"وَإِذَا ٱنقَلَبُوٓاْ إِلَىٰٓ أَهۡلِهِمُ ٱنقَلَبُواْ فَكِهِينَ",true],[83,32,"وَإِذَا رَأَوۡهُمۡ قَالُوٓاْ",false]]},{"l":[[83,32,"إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ",true],[83,33,"وَمَآ أُرۡسِلُواْ عَلَيۡهِمۡ حَٰفِظِينَ",true]]}]}