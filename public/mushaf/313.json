{"p":313,"j":16,"rows":[{"l":[[20,13,"وَأَنَا ٱخۡتَرۡتُكَ فَٱسۡتَمِعۡ لِمَا يُوحَىٰٓ",true],[20,14,"إِنَّنِيٓ أَنَا ٱللَّهُ لَآ إِلَٰهَ إِلَّآ أَنَا۠",false]]},{"l":[[20,14,"فَٱعۡبُدۡنِي وَأَقِمِ ٱلصَّلَوٰةَ لِذِكۡرِيٓ",true],[20,15,"إِنَّ ٱلسَّاعَةَ ءَاتِيَةٌ",false]]},{"l":[[20,15,"أَكَادُ أُخۡفِيهَا لِتُجۡزَىٰ كُلُّ نَفۡسِۭ بِمَا تَسۡعَىٰ",true],[20,16,"فَلَا يَصُدَّنَّكَ",false]]},{"l":[[20,16,"عَنۡهَا مَن لَّا يُؤۡمِنُ بِهَا وَٱتَّبَعَ هَوَىٰهُ فَتَرۡدَىٰ",true],[20,17,"وَمَا تِلۡكَ",false]]},{"l":[[20,17,"بِيَمِينِكَ يَٰمُوسَىٰ",true],[20,18,"قَالَ هِيَ عَصَايَ أَتَوَكَّؤُاْ عَلَيۡهَا",false]]},{"l":[[20,18,"وَأَهُشُّ بِهَا عَلَىٰ غَنَمِي وَلِيَ فِيهَا مَـَٔارِبُ أُخۡرَىٰ",true],[20,19,"قَالَ أَلۡقِهَا",false]]},{"l":[[20,19,"يَٰمُوسَىٰ",true],[20,20,"فَأَلۡقَىٰهَا فَإِذَا هِيَ حَيَّةࣱ تَسۡعَىٰ",true],[20,21,"قَالَ خُذۡهَا",false]]},{"l":[[20,21,"وَلَا تَخَفۡۖ سَنُعِيدُهَا سِيرَتَهَا ٱلۡأُولَىٰ",true],[20,22,"وَٱضۡمُمۡ يَدَكَ",false]]},{"l":[[20,22,"إِلَىٰ جَنَاحِكَ تَخۡرُجۡ بَيۡضَآءَ مِنۡ غَيۡرِ سُوٓءٍ ءَايَةً أُخۡرَىٰ",true],[20,23,"لِنُرِيَكَ",false]]},{"l":[[20,23,"مِنۡ ءَايَٰتِنَا ٱلۡكُبۡرَى",true],[20,24,"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ",true],[20,25,"قَالَ",false]]},{"l":[[20,25,"رَبِّ ٱشۡرَحۡ لِي صَدۡرِي",true],[20,26,"وَيَسِّرۡ لِيٓ أَمۡرِي",true],[20,27,"وَٱحۡلُلۡ عُقۡدَةࣰ مِّن",false]]},{"l":[[20,27,"لِّسَانِي",true],[20,28,"يَفۡقَهُواْ قَوۡلِي",true],[20,29,"وَٱجۡعَل لِّي وَزِيرࣰا مِّنۡ أَهۡلِي",true],[20,30,"هَٰرُونَ",false]]},{"l":[[20,30,"أَخِي",true],[20,31,"ٱشۡدُدۡ بِهِۦٓ أَزۡرِي",true],[20,32,"وَأَشۡرِكۡهُ فِيٓ أَمۡرِي",true],[20,33,"كَيۡ نُسَبِّحَكَ",false]]},{"l":[[20,33,"كَثِيرࣰا",true],[20,34,"وَنَذۡكُرَكَ كَثِيرًا",true],[20,35,"إِنَّكَ كُنتَ بِنَا بَصِيرࣰا",true],[20,36,"قَالَ قَدۡ",false]]},{"l":[[20,36,"أُوتِيتَ سُؤۡلَكَ يَٰمُوسَىٰ",true],[20,37,"وَلَقَدۡ مَنَنَّا عَلَيۡكَ مَرَّةً أُخۡرَىٰٓ",true]]}]}