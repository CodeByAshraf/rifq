{"p":372,"j":19,"rows":[{"l":[[26,112,"قَالَ وَمَا عِلۡمِي بِمَا كَانُواْ يَعۡمَلُونَ",true],[26,113,"إِنۡ حِسَابُهُمۡ إِلَّا عَلَىٰ رَبِّيۖ",false]]},{"l":[[26,113,"لَوۡ تَشۡعُرُونَ",true],[26,114,"وَمَآ أَنَا۠ بِطَارِدِ ٱلۡمُؤۡمِنِينَ",true],[26,115,"إِنۡ أَنَا۠ إِلَّا نَذِيرࣱ",false]]},{"l":[[26,115,"مُّبِينࣱ",true],[26,116,"قَالُواْ لَئِن لَّمۡ تَنتَهِ يَٰنُوحُ لَتَكُونَنَّ مِنَ ٱلۡمَرۡجُومِينَ",true],[26,117,"قَالَ رَبِّ",false]]},{"l":[[26,117,"إِنَّ قَوۡمِي كَذَّبُونِ",true],[26,118,"فَٱفۡتَحۡ بَيۡنِي وَبَيۡنَهُمۡ فَتۡحࣰا وَنَجِّنِي وَمَن مَّعِيَ",false]]},{"l":[[26,118,"مِنَ ٱلۡمُؤۡمِنِينَ",true],[26,119,"فَأَنجَيۡنَٰهُ وَمَن مَّعَهُۥ فِي ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ",true]]},{"l":[[26,120,"ثُمَّ أَغۡرَقۡنَا بَعۡدُ ٱلۡبَاقِينَ",true],[26,121,"إِنَّ فِي ذَٰلِكَ لَأٓيَةࣰۖ وَمَا كَانَ",false]]},{"l":[[26,121,"أَكۡثَرُهُم مُّؤۡمِنِينَ",true],[26,122,"وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ",true],[26,123,"كَذَّبَتۡ",false]]},{"l":[[26,123,"عَادٌ ٱلۡمُرۡسَلِينَ",true],[26,124,"إِذۡ قَالَ لَهُمۡ أَخُوهُمۡ هُودٌ أَلَا تَتَّقُونَ",true],[26,125,"إِنِّي لَكُمۡ",false]]},{"l":[[26,125,"رَسُولٌ أَمِينࣱ",true],[26,126,"فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ",true],[26,127,"وَمَآ أَسۡـَٔلُكُمۡ عَلَيۡهِ",false]]},{"l":[[26,127,"مِنۡ أَجۡرٍۖ إِنۡ أَجۡرِيَ إِلَّا عَلَىٰ رَبِّ ٱلۡعَٰلَمِينَ",true],[26,128,"أَتَبۡنُونَ بِكُلِّ رِيعٍ",false]]},{"l":[[26,128,"ءَايَةࣰ تَعۡبَثُونَ",true],[26,129,"وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمۡ تَخۡلُدُونَ",true]]},{"l":[[26,130,"وَإِذَا بَطَشۡتُم بَطَشۡتُمۡ جَبَّارِينَ",true],[26,131,"فَٱتَّقُواْ ٱللَّهَ وَأَطِيعُونِ",true]]},{"l":[[26,132,"وَٱتَّقُواْ ٱلَّذِيٓ أَمَدَّكُم بِمَا تَعۡلَمُونَ",true],[26,133,"أَمَدَّكُم بِأَنۡعَٰمࣲ وَبَنِينَ",true]]},{"l":[[26,134,"وَجَنَّٰتࣲ وَعُيُونٍ",true],[26,135,"إِنِّيٓ أَخَافُ عَلَيۡكُمۡ عَذَابَ يَوۡمٍ عَظِيمࣲ",true]]},{"l":[[26,136,"قَالُواْ سَوَآءٌ عَلَيۡنَآ أَوَعَظۡتَ أَمۡ لَمۡ تَكُن مِّنَ ٱلۡوَٰعِظِينَ",true]]}]}