{"p":591,"j":30,"rows":[{"h":86},{"b":1},{"l":[[86,1,"وَٱلسَّمَآءِ وَٱلطَّارِقِ",true],[86,2,"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ",true],[86,3,"ٱلنَّجۡمُ ٱلثَّاقِبُ",true]]},{"l":[[86,4,"إِن كُلُّ نَفۡسࣲ لَّمَّا عَلَيۡهَا حَافِظࣱ",true],[86,5,"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ",true]]},{"l":[[86,6,"خُلِقَ مِن مَّآءࣲ دَافِقࣲ",true],[86,7,"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ",true],[86,8,"إِنَّهُۥ",false]]},{"l":[[86,8,"عَلَىٰ رَجۡعِهِۦ لَقَادِرࣱ",true],[86,9,"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ",true],[86,10,"فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا",false]]},{"l":[[86,10,"نَاصِرࣲ",true],[86,11,"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ",true],[86,12,"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ",true]]},{"l":[[86,13,"إِنَّهُۥ لَقَوۡلࣱ فَصۡلࣱ",true],[86,14,"وَمَا هُوَ بِٱلۡهَزۡلِ",true],[86,15,"إِنَّهُمۡ يَكِيدُونَ كَيۡدࣰا",true]]},{"l":[[86,16,"وَأَكِيدُ كَيۡدࣰا",true],[86,17,"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا",true]]},{"h":87},{"b":1},{"l":[[87,1,"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى",true],[87,2,"ٱلَّذِي خَلَقَ فَسَوَّىٰ",true],[87,3,"وَٱلَّذِي قَدَّرَ",false]]},{"l":[[87,3,"فَهَدَىٰ",true],[87,4,"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ",true],[87,5,"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ",true]]},{"l":[[87,6,"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ",true],[87,7,"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ",true]]},{"l":[[87,8,"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ",true],[87,9,"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ",true],[87,10,"سَيَذَّكَّرُ مَن يَخۡشَىٰ",true]]}]}