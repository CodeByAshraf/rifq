{"p":532,"j":27,"rows":[{"l":[[55,19,"مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ",true],[55,20,"بَيۡنَهُمَا بَرۡزَخࣱ لَّا يَبۡغِيَانِ",true],[55,21,"فَبِأَيِّ ءَالَآءِ",false]]},{"l":[[55,21,"رَبِّكُمَا تُكَذِّبَانِ",true],[55,22,"يَخۡرُجُ مِنۡهُمَا ٱللُّؤۡلُؤُ وَٱلۡمَرۡجَانُ",true],[55,23,"فَبِأَيِّ ءَالَآءِ",false]]},{"l":[[55,23,"رَبِّكُمَا تُكَذِّبَانِ",true],[55,24,"وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشَـَٔاتُ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ",true]]},{"l":[[55,25,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",true],[55,26,"كُلُّ مَنۡ عَلَيۡهَا فَانࣲ",true],[55,27,"وَيَبۡقَىٰ وَجۡهُ",false]]},{"l":[[55,27,"رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ",true],[55,28,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",true]]},{"l":[[55,29,"يَسۡـَٔلُهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنࣲ",true],[55,30,"فَبِأَيِّ",false]]},{"l":[[55,30,"ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",true],[55,31,"سَنَفۡرُغُ لَكُمۡ أَيُّهَ ٱلثَّقَلَانِ",true],[55,32,"فَبِأَيِّ",false]]},{"l":[[55,32,"ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",true],[55,33,"يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمۡ",false]]},{"l":[[55,33,"أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنفُذُونَ",false]]},{"l":[[55,33,"إِلَّا بِسُلۡطَٰنࣲ",true],[55,34,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",true],[55,35,"يُرۡسَلُ عَلَيۡكُمَا",false]]},{"l":[[55,35,"شُوَاظࣱ مِّن نَّارࣲ وَنُحَاسࣱ فَلَا تَنتَصِرَانِ",true],[55,36,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا",false]]},{"l":[[55,36,"تُكَذِّبَانِ",true],[55,37,"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتۡ وَرۡدَةࣰ كَٱلدِّهَانِ",true]]},{"l":[[55,38,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",true],[55,39,"فَيَوۡمَئِذࣲ لَّا يُسۡـَٔلُ عَن",false]]},{"l":[[55,39,"ذَنۢبِهِۦٓ إِنسࣱ وَلَا جَآنࣱّ",true],[55,40,"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",true]]},{"l":[[55,41,"يُعۡرَفُ ٱلۡمُجۡرِمُونَ بِسِيمَٰهُمۡ فَيُؤۡخَذُ بِٱلنَّوَٰصِي وَٱلۡأَقۡدَامِ",true]]}]}