{"p":595,"j":30,"rows":[{"l":[[90,19,"وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ",true],[90,20,"عَلَيۡهِمۡ نَارࣱ مُّؤۡصَدَةُۢ",true]]},{"h":91},{"b":1},{"l":[[91,1,"وَٱلشَّمۡسِ وَضُحَىٰهَا",true],[91,2,"وَٱلۡقَمَرِ إِذَا تَلَىٰهَا",true],[91,3,"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",true]]},{"l":[[91,4,"وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا",true],[91,5,"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",true],[91,6,"وَٱلۡأَرۡضِ",false]]},{"l":[[91,6,"وَمَا طَحَىٰهَا",true],[91,7,"وَنَفۡسࣲ وَمَا سَوَّىٰهَا",true],[91,8,"فَأَلۡهَمَهَا فُجُورَهَا",false]]},{"l":[[91,8,"وَتَقۡوَىٰهَا",true],[91,9,"قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا",true],[91,10,"وَقَدۡ خَابَ مَن دَسَّىٰهَا",true]]},{"l":[[91,11,"كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ",true],[91,12,"إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا",true],[91,13,"فَقَالَ لَهُمۡ",false]]},{"l":[[91,13,"رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا",true],[91,14,"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ",false]]},{"l":[[91,14,"عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا",true],[91,15,"وَلَا يَخَافُ عُقۡبَٰهَا",true]]},{"h":92},{"b":1},{"l":[[92,1,"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ",true],[92,2,"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",true],[92,3,"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ",true]]},{"l":[[92,4,"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ",true],[92,5,"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ",true],[92,6,"وَصَدَّقَ بِٱلۡحُسۡنَىٰ",true]]},{"l":[[92,7,"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ",true],[92,8,"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ",true],[92,9,"وَكَذَّبَ بِٱلۡحُسۡنَىٰ",true]]}]}