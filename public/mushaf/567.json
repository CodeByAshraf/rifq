{"p":567,"j":29,"rows":[{"l":[[69,9,"وَجَآءَ فِرۡعَوۡنُ وَمَن قَبۡلَهُۥ وَٱلۡمُؤۡتَفِكَٰتُ بِٱلۡخَاطِئَةِ",true],[69,10,"فَعَصَوۡاْ رَسُولَ",false]]},{"l":[[69,10,"رَبِّهِمۡ فَأَخَذَهُمۡ أَخۡذَةࣰ رَّابِيَةً",true],[69,11,"إِنَّا لَمَّا طَغَا ٱلۡمَآءُ حَمَلۡنَٰكُمۡ فِي",false]]},{"l":[[69,11,"ٱلۡجَارِيَةِ",true],[69,12,"لِنَجۡعَلَهَا لَكُمۡ تَذۡكِرَةࣰ وَتَعِيَهَآ أُذُنࣱ وَٰعِيَةࣱ",true],[69,13,"فَإِذَا نُفِخَ",false]]},{"l":[[69,13,"فِي ٱلصُّورِ نَفۡخَةࣱ وَٰحِدَةࣱ",true],[69,14,"وَحُمِلَتِ ٱلۡأَرۡضُ وَٱلۡجِبَالُ فَدُكَّتَا دَكَّةࣰ",false]]},{"l":[[69,14,"وَٰحِدَةࣰ",true],[69,15,"فَيَوۡمَئِذࣲ وَقَعَتِ ٱلۡوَاقِعَةُ",true],[69,16,"وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِيَ يَوۡمَئِذࣲ",false]]},{"l":[[69,16,"وَاهِيَةࣱ",true],[69,17,"وَٱلۡمَلَكُ عَلَىٰٓ أَرۡجَآئِهَاۚ وَيَحۡمِلُ عَرۡشَ رَبِّكَ فَوۡقَهُمۡ يَوۡمَئِذࣲ",false]]},{"l":[[69,17,"ثَمَٰنِيَةࣱ",true],[69,18,"يَوۡمَئِذࣲ تُعۡرَضُونَ لَا تَخۡفَىٰ مِنكُمۡ خَافِيَةࣱ",true],[69,19,"فَأَمَّا مَنۡ أُوتِيَ",false]]},{"l":[[69,19,"كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقۡرَءُواْ كِتَٰبِيَهۡ",true],[69,20,"إِنِّي ظَنَنتُ أَنِّي مُلَٰقٍ",false]]},{"l":[[69,20,"حِسَابِيَهۡ",true],[69,21,"فَهُوَ فِي عِيشَةࣲ رَّاضِيَةࣲ",true],[69,22,"فِي جَنَّةٍ عَالِيَةࣲ",true],[69,23,"قُطُوفُهَا",false]]},{"l":[[69,23,"دَانِيَةࣱ",true],[69,24,"كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَآ أَسۡلَفۡتُمۡ فِي ٱلۡأَيَّامِ ٱلۡخَالِيَةِ",true]]},{"l":[[69,25,"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيۡتَنِي لَمۡ أُوتَ كِتَٰبِيَهۡ",true],[69,26,"وَلَمۡ أَدۡرِ",false]]},{"l":[[69,26,"مَا حِسَابِيَهۡ",true],[69,27,"يَٰلَيۡتَهَا كَانَتِ ٱلۡقَاضِيَةَ",true],[69,28,"مَآ أَغۡنَىٰ عَنِّي مَالِيَهۡۜ",true],[69,29,"هَلَكَ",false]]},{"l":[[69,29,"عَنِّي سُلۡطَٰنِيَهۡ",true],[69,30,"خُذُوهُ فَغُلُّوهُ",true],[69,31,"ثُمَّ ٱلۡجَحِيمَ صَلُّوهُ",true],[69,32,"ثُمَّ فِي سِلۡسِلَةࣲ",false]]},{"l":[[69,32,"ذَرۡعُهَا سَبۡعُونَ ذِرَاعࣰا فَٱسۡلُكُوهُ",true],[69,33,"إِنَّهُۥ كَانَ لَا يُؤۡمِنُ بِٱللَّهِ ٱلۡعَظِيمِ",true]]},{"l":[[69,34,"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ",true],[69,35,"فَلَيۡسَ لَهُ ٱلۡيَوۡمَ هَٰهُنَا حَمِيمࣱ",true]]}]}